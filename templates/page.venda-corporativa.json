/\/files\/videos\/FUNDO_Venda corporativa-DESK_d47f2463-9f40-4afb-8e9d-9e07a22f03a0.mp4","link":"","open_link":"_blank","bn_design":"text_overlay","text_align":"text-center","text_horizontal_position":"center","text_position":"center","content_bg_color":"","background_gradient":"","content_width":50,"banner_height":"depend-image","height_dk":800,"height_tb":600,"height_mb":360,"height_full":false,"content_box":"content_in_container","bg_opacity":100,"text_bellow_mobile":false,"img_position":"left","banner_width":"col-md-6","column_gap":30,"secao_borda_esq":20,"hover_effect":"zoom","padding_top":0,"padding_bottom":0,"reset_spacing":true}},"banner_with_text_AGgMwK":{"type":"banner-with-text","blocks":{"image_picker_HwrR4p":{"type":"image_picker","settings":{"image_block":"shopify:\/\/shop_images\/LOGOTIPO_branco.svg","icon_width_block":160,"icon_max_width_block":100,"text_img_mt":1,"text_img_mb":15}},"heading_XUJDD3":{"type":"heading","settings":{"title":"Leve mais significado e reconhecimento para sua equipe.","heading_fs":32,"heading_fw":"default","heading_tf":"unset","heading_mt":0,"heading_mb":10}},"text_HThUE8":{"type":"text","settings":{"txt_content":"<p>Fale com nosso time corporativo e desenvolva um <strong>projeto personalizado<\/strong> para sua empresa.<\/p>","txt_fs":16,"txt_fw":"default","txt_tf":"unset","txt_mt":0,"txt_mb":20}},"buttons_WX3tjE":{"type":"buttons","settings":{"btn_content":"Fazer orçamento","button_type":"secondary","button_link":"#link-cta","button_target":false,"b_mt":0,"b_mb":0}}},"block_order":["image_picker_HwrR4p","heading_XUJDD3","text_HThUE8","buttons_WX3tjE"],"custom_css":["@media (min-width: 768px) {section {display: none !important; }}",".btn-primary {padding: 1.36rem 5.5rem !important;}",".btn-secondary {padding: 1.36rem 5.5rem !important;}"],"name":"Banner with text - MOB","settings":{"container":"full-width","color_scheme":"scheme-c5385370-dcdb-4921-a8bb-438b6b2d09e0","image_behavior":"fixed","banner_type":"video","video_url":"https:\/\/www.youtube.com\/watch?v=_9VUPq3SxOc","video_local":"shopify:\/\/files\/videos\/FUNDO_Venda corporativa-MOB(1).mp4","link":"","open_link":"_blank","bn_design":"text_overlay","text_align":"text-center","text_horizontal_position":"center","text_position":"center","content_bg_color":"","background_gradient":"","content_width":50,"banner_height":"depend-image","height_dk":800,"height_tb":600,"height_mb":360,"height_full":false,"content_box":"content_in_container","bg_opacity":100,"text_bellow_mobile":false,"img_position":"left","banner_width":"col-md-6","column_gap":30,"secao_borda_esq":20,"hover_effect":"zoom","padding_top":0,"padding_bottom":0,"reset_spacing":true}},"faq_nWMLgP":{"type":"faq","blocks":{"faq_fzVfzx":{"type":"faq","settings":{"title":"A Orgânica oferece soluções para empresas?","content":"<p>Sim! Oferecemos soluções corporativas e B2B especialmente desenvolvidas para empresas que desejam presentear clientes, colaboradores ou parceiros. Temos opções de produtos a granel, kits personalizados e condições especiais. Entre em contato com nosso time de Vendas Corporativas.<\/p>"}},"faq_pR8eWX":{"type":"faq","settings":{"title":"Como funciona uma compra corporativa?","content":"<p>Para compras corporativas, entre em contato com nossa equipe de Vendas B2B através do e-mail ou WhatsApp da Central de Atendimento. Você será direcionado para um especialista que analisará suas necessidades, oferecerá opções personalizadas e elaborará uma proposta comercial específica para sua empresa.<\/p>"}},"faq_QP8G7P":{"type":"faq","settings":{"title":"Quais são as quantidades mínimas para uma compra corporativa?","content":"<p>As quantidades mínimas variam conforme o tipo de produto e solução desejada. Nossa equipe de Vendas Corporativas analisará seu projeto e oferecerá opções flexíveis. Entre em contato para discutir seus objetivos e receber uma proposta adequada.<\/p>"}},"faq_9nrT4Q":{"type":"faq","settings":{"title":"Oferecemos descontos para grandes volumes?","content":"<p>Sim! Para compras em volume, oferecemos tabelas de desconto progressivas que variam conforme a quantidade e o tipo de produto. Quanto maior o volume, maiores podem ser as vantagens comerciais. Solicite sua cotação personalizada.<\/p>"}},"faq_cmP49V":{"type":"faq","settings":{"title":"Posso personalizar produtos para minha empresa?","content":"<p>Sim! Oferecemos a opção de personalização em alguns produtos, incluindo embalagem customizada com sua marca, cores corporativas e mensagens personalizadas. As possibilidades de customização variam conforme o produto. Consulte nosso time para conhecer as opções disponíveis.<\/p>"}},"faq_kCqq7w":{"type":"faq","settings":{"title":"Qual é o prazo de entrega para pedidos corporativos?","content":"<p>Os prazos de entrega para pedidos corporativos são negociados conforme o volume e a complexidade do projeto. Em geral, trabalhamos com prazos de 15 a 30 dias úteis, mas isso pode variar. Seu gerente de contas confirmará o cronograma específico após análise.<\/p>"}},"faq_p799y6":{"type":"faq","settings":{"title":"Oferecemos invoice\/nota fiscal corporativa?","content":"<p>Sim! Todos os pedidos corporativos são acompanhados de documentação apropriada para empresas, incluindo nota fiscal completa, detalhamento de itens e prazos de pagamento conforme acordado.<\/p>"}},"faq_BMKzRT":{"type":"faq","settings":{"title":"Como solicitar uma proposta de venda corporativa?","content":"<p>Entre em contato através do:<\/p><ul><li>WhatsApp:  (<a href=\"https:\/\/api.whatsapp.com\/send?l=pt&phone=5511937038931&text=Poderia%20me%20ajudar?\">11) 93703 8931<\/a><\/li><li>E-mail: <strong>comercial@grupoorganica.com.br<\/strong><\/li><li>Ou clique em “Fale Conosco” &gt; “Vendas Corporativas”<\/li><\/ul><p>Forneça informações sobre:<\/p><ul><li>Nome da empresa<\/li><li>Quantidade de produtos desejados<\/li><li>Tipo de produtos de interesse<\/li><li>Orçamento aproximado<\/li><li>Data necessária para entrega<\/li><li>Se há interesse em personalização<\/li><\/ul><p>Nossa equipe entrará em contato dentro de 2 dias úteis.<\/p>"}},"faq_AHTQRM":{"type":"faq","settings":{"title":"Há prazos de pagamento especiais para empresas?","content":"<p>Sim! Para pedidos corporativos acima de determinado valor, podemos oferecer condições de pagamento flexíveis, incluindo parcelamento, entrada + boleto, ou outros arranjos. Isso será discutido com seu gerente de contas durante a proposta.<\/p>"}},"faq_acWLXK":{"type":"faq","settings":{"title":"Vocês atendem pessoa jurídica (CNPJ)?","content":"<p>Sim! Aceitamos compras de pessoa jurídica com CNPJ. Para essas operações, solicitamos documentação apropriada e oferecemos documentação fiscal adequada. Entre em contato com nosso time B2B para formalizar o cadastro.<\/p>"}},"faq_xC9HRm":{"type":"faq","settings":{"title":"Posso fazer uma compra corporativa de diferentes linhas de produtos?","content":"<p>Sim! Nossa proposta corporativa é flexível e você pode combinar produtos de diferentes linhas (corpo & banho, cabelos, infantil, etc.) conforme necessário. Seu gerente analisará as melhores opções para seu objetivo.<\/p>"}},"faq_fNdLiy":{"type":"faq","settings":{"title":"Como funciona o atendimento pós-venda para empresas?","content":"<p>Cada cliente corporativo tem um gerente de contas dedicado que oferece suporte contínuo. Você tem acesso prioritário ao nosso time para tirar dúvidas, reportar problemas e solicitar ajustes futuros. Estamos sempre à sua disposição!<\/p>"}}},"block_order":["faq_fzVfzx","faq_pR8eWX","faq_QP8G7P","faq_9nrT4Q","faq_cmP49V","faq_kCqq7w","faq_p799y6","faq_BMKzRT","faq_AHTQRM","faq_acWLXK","faq_xC9HRm","faq_fNdLiy"],"name":"t:sections.faq.name","settings":{"heading_logo_svg":"","heading":"Dúvidas Frequentes","description":"","text_alignment":"text-center","container":"container","color_scheme":"scheme-04a42673-df7b-475a-b88d-6926ccfbcf18","padding_top":60,"padding_bottom":100,"reset_spacing":false}}},"order":["main","banner_with_text_qpXBip","banner_with_text