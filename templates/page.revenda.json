ge_behavior":"none","text_position":"top","content_on_mobile":false,"reset_color_mb":false,"padding_top":0,"padding_bottom":0,"reset_spacing":true}},"spacing_XdhHVH":{"type":"spacing","name":"t:sections.spacing.name","settings":{"spacing_desktop":5,"spacing_moible":5}},"custom_text_LRkdjD":{"type":"custom-text","blocks":{"sub_heading_nGFyTw":{"type":"sub_heading","settings":{"sub_heading":"<p><strong>Comece agora<\/strong><\/p>","sub_fs":12,"sub_fw":"default","sub_tf":"uppercase","sub_mt":0,"sub_mb":0}},"heading_nbcmQ3":{"type":"heading","disabled":true,"settings":{"heading":"Quero revender Orgânica","heading_fs":32,"heading_fw":"default","heading_tf":"unset","heading_mt":0,"heading_mb":0}},"desc_hPpFGh":{"type":"desc","settings":{"desc":"<p>Preencha seus dados e nossa equipe comercial entrará em contato com as melhores condições para o seu negócio.<\/p>","desc_fs":16,"desc_fw":"default","content_width":40,"desc_tf":"unset","desc_mt":25,"desc_mb":0}}},"block_order":["sub_heading_nGFyTw","heading_nbcmQ3","desc_hPpFGh"],"name":"t:sections.custom-content.name","settings":{"container":"container","text_align":"text-center","color_scheme":"","custom_class":"","padding_top":60,"padding_bottom":0,"reset_spacing":true}},"custom_html_8JfrPV":{"type":"custom-html","name":"t:sections.custom-html.name","settings":{"heading_logo_svg":"","heading":"","description":"","text_alignment":"text-center","container":"container","color_scheme":"default-color-scheme","content_html":"<style>\n  .custom-html-wrapper {\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    align-items: center;\n    width: 100%;\n    gap: 20px;\n  }\n  \n  .custom-html-wrapper > * {\n    margin: 0 auto;\n    display: block;\n  }\n  \n  .custom-html-wrapper iframe {\n    display: block;\n    margin: 0 auto;\n  }\n  \n  .custom-html-wrapper img {\n    display: block;\n    margin: 0 auto;\n    max-width: 100%;\n    height: auto;\n  }\n  \n  .custom-html-wrapper p,\n  .custom-html-wrapper h1,\n  .custom-html-wrapper h2,\n  .custom-html-wrapper h3,\n  .custom-html-wrapper h4,\n  .custom-html-wrapper h5,\n  .custom-html-wrapper h6 {\n    text-align: center;\n    width: 100%;\n  }\n<\/style>\n\n<div class=\"custom-html-wrapper\">\n  <iframe src=\"https:\/\/docs.google.com\/forms\/d\/e\/1FAIpQLSdT04WPrzNwNGLg6kw0x4sMLxCBA5AjKNg3waeWfxSr15nIcA\/viewform?embedded=true\" width=\"640\" height=\"1300\" frameborder=\"0\" marginheight=\"0\" marginwidth=\"0\">Carregando…<\/iframe>\n<\/div>","padding_top":0,"padding_bottom":0,"reset_spacing":false}},"faq_NVkKYP":{"type":"faq","blocks":{"faq_bUm3iE":{"type":"faq","settings":{"title":"A Orgânica oferece soluções para empresas?","content":"<p>Sim! Oferecemos soluções corporativas e B2B especialmente desenvolvidas para empresas que desejam presentear clientes, colaboradores ou parceiros. Temos opções de produtos a granel, kits personalizados e condições especiais. Entre em contato com nosso time de Vendas Corporativas.<\/p>"}},"faq_WNyHBJ":{"type":"faq","settings":{"title":"Como funciona uma compra corporativa?","content":"<p>Para compras corporativas, entre em contato com nossa equipe de Vendas B2B através do e-mail ou WhatsApp da Central de Atendimento. Você será direcionado para um especialista que analisará suas necessidades, oferecerá opções personalizadas e elaborará uma proposta comercial específica para sua empresa.<\/p>"}},"faq_gUeicz":{"type":"faq","settings":{"title":"Quais são as quantidades mínimas para uma compra corporativa?","content":"<p>As quantidades mínimas variam conforme o tipo de produto e solução desejada. Nossa equipe de Vendas Corporativas analisará seu projeto e oferecerá opções flexíveis. Entre em contato para discutir seus objetivos e receber uma proposta adequada.<\/p>"}},"faq_gGDJ39":{"type":"faq","settings":{"title":"Oferecemos descontos para grandes volumes?","content":"<p>Sim! Para compras em volume, oferecemos tabelas de desconto progressivas que variam conforme a quantidade e o tipo de produto. Quanto maior o volume, maiores podem ser as vantagens comerciais. Solicite sua cotação personalizada.<\/p>"}},"faq_8RGXCG":{"type":"faq","settings":{"title":"Qual é o prazo de entrega para pedidos corporativos?","content":"<p>Os prazos de entrega para pedidos corporativos são negociados conforme o volume e a complexidade do projeto. Em geral, trabalhamos com prazos de 15 a 30 dias úteis, mas isso pode variar. Seu gerente de contas confirmará o cronograma específico após análise.<\/p>"}},"faq_wLeY6G":{"type":"faq","settings":{"title":"Oferecemos invoice\/nota fiscal corporativa?","content":"<p>Sim! Todos os pedidos corporativos são acompanhados de documentação apropriada para empresas, incluindo nota fiscal completa, detalhamento de itens e prazos de pagamento conforme acordado.<\/p>"}},"faq_zF3qeb":{"type":"faq","settings":{"title":"Há prazos de pagamento especiais para empresas?","content":"<p>Sim! Para pedidos corporativos acima de determinado valor, podemos oferecer condições de pagamento flexíveis, incluindo parcelamento, entrada + boleto, ou outros arranjos. Isso será discutido com seu gerente de contas durante a proposta.<\/p>"}},"faq_rJ8Beb":{"type":"faq","settings":{"title":"Vocês atendem pessoa jurídica (CNPJ)?","content":"<p>Sim! Aceitamos compras de pessoa jurídica com CNPJ. Para essas operações, solicitamos documentação apropriada e oferecemos documentação fiscal adequada. Entre em contato com nosso time B2B para formalizar o cadastro.<\/p>"}},"faq_LpjWVA":{"type":"faq","settings":{"title":"Posso fazer uma compra corporativa de diferentes linhas de produtos?","content":"<p>Sim! Nossa proposta corporativa é flexível e você pode combinar produtos de diferentes linhas (corpo & banho, cabelos, infantil, etc.) conforme necessário. Seu gerente analisará as melhores opções para seu objetivo.<\/p>"}},"faq_C6tA9K":{"type":"faq","settings":{"title":"Como funciona o atendimento pós-venda para empresas?","content":"<p>Cada cliente corporativo tem um gerente de contas dedicado que oferece suporte contínuo. Você tem acesso prioritário ao nosso time para tirar dúvidas, reportar problemas e solicitar ajustes futuros. Estamos sempre à sua disposição!<\/p>"}}},"block_order":["faq_bUm3iE","faq_WNyHBJ","faq_gUeicz","faq_gGDJ39","faq_8RGXCG","faq_wLeY6G","faq_zF3qeb","faq_rJ8Beb","faq_LpjWVA","faq_C6tA9K"],"name":"t:sections.faq.name","settings":{"heading_logo_svg":"","heading":"Dúvidas Frequentes","description":"","text_alignment":"text-center","container":"container","color_scheme":"scheme-04a42673-df7b-475a-b88d-6926ccfbcf18","padding_top":30,"padding_bottom":100,"reset_spacing":false}}},"order":["main","banner_with_text_qpXBip","banner_with_text_fxNaqy","custom_text_QXkcQU","jejoom_letreiro_tRmAHj","banner_image_Te8LVw","banner_with_text_iQWzHM","scrolling_text_jpXTCX","icon_box_p7CQwV","banner_image_7mCY8w","spacing_XdhHVH","custom_text_LRkdjD","custom_html_8JfrPV","faq_NVkKYP"]}