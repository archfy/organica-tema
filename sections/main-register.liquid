{{ 'custormer.css' | asset_url | stylesheet_tag }}
<div class="customer-register">
  <div class="container">
    <div class="customer-form register-form col-md-6 col-sm-8 m-auto">
      {% form 'create_customer' , class: 'custormer-register-form' %}
        {%- if form.errors -%}
            <ul class="error error-list">
              {%- for field in form.errors -%}
                  <li>
                      {%- if field == 'form' -%}
                          {{ form.errors.messages[field] }}
                      {%- else -%}
                        <a href="#RegisterForm-{{ field }}" class="link link-underline">
                          <span class="text">
                              {{ form.errors.translated_fields[field] | capitalize }}
                              {{ form.errors.messages[field] }}
                          </span>
                        </a>
                      {%- endif -%}
                  </li>
              {%- endfor -%}
          </ul>
        {% endif %}
        <div class="form-group mb-20 d-flex flex-column first-name">
            <label class="form-label pb-5" for="first-name">Nome<span class="required">*</span></label>
            <input type="text" id="first-name" placeholder="Nome" name="customer[first_name]">
        </div>
        <div class="form-group mb-20 d-flex flex-column last-name">
            <label class="form-label pb-5" for="last-name">Sobrenome<span class="required">*</span></label>
            <input type="text" id="last-name" name="customer[last_name]" placeholder="Sobrenome">
        </div>
        <div class="form-group mb-20 d-flex flex-column email">
            <label class="pb-5" for="email">E-mail<span class="required">*</span></label>
            <input 
              type="email" 
              name="customer[email]"
              placeholder="E-mail"
              required
              id="email"
            >
        </div>
        <div class="form-group mb-20 d-flex flex-column password">
            <label class="form-label pb-5" for="password">Senha<span class="required">*</span></label>
            <input 
              type="password"
              name="customer[password]"
              placeholder="Senha"
              required
              id="password"
            >
        </div>
        <p>
          Ao criar uma conta, você concorda com os Termos de Serviço e a Política de Privacidade da loja.
        </p>
        <div class="submit mt-30 d-flex flex-column">
            <input class="btn-primary w-full text-center" type="submit" value="Criar conta">
            <a href="{{ routes.account_login_url }}" class="btn btn-secondary w-full text-center mt-20">Fazer login</a>
        </div>
      {% endform %}
    </div>
  </div>
</div>