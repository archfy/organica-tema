{% comment %}
  Seção Shopify: Letreiro Horizontal
  - Bloco de letreiro com texto e ícones customizáveis que se move horizontalmente.
  - Permite múltiplos itens (blocos) com texto e ícone individual.
  - Opções de cor de fundo, texto, ícone, tamanho de fonte e ícone, velocidade e direção.
  - Pausa ao passar o mouse para melhor usabilidade.
  - Compatível com o editor de temas Shopify.
{% endcomment %}

{% comment %}
  Seção Shopify: Letreiro Horizontal
  - Agora com loop infinito perfeito sem espaços em branco
{% endcomment %}

{%- liquid
  assign current_section_id = section.id
  assign bg_color = section.settings.bg_color
  assign altura_letreiro = section.settings.altura_letreiro
  assign reverse_icon = section.settings.reverse_icon
  assign text_color = section.settings.text_color
  assign icon_color = section.settings.icon_color
  assign font_size = section.settings.font_size
  assign font_weight = section.settings.font_weight
  assign icon_size = section.settings.icon_size
  assign speed = section.settings.speed
  assign reverse = section.settings.reverse
  assign pause_on_hover = section.settings.pause_on_hover
  assign item_spacing = section.settings.item_spacing
  assign item_spacing_bloco = section.settings.item_spacing_bloco
-%}

{%- style -%}
  .bls__shipping{
  padding-right: 0px!important;
  padding-left: 90px!important;
  }

  .marquee-section-{{ current_section_id }} {
    width: 100%;
    overflow: hidden; /* Garante que nada vaze */
    
  }

  .marquee-container-{{ current_section_id }} {
    background-color: {{ bg_color }};
    overflow: hidden;
    white-space: nowrap;
    height: 66px;
    display: flex;
    align-items: center;
    position: relative;
    height:{{ altura_letreiro }}px;
  }

  .marquee-wrapper-{{ current_section_id }} {
    display: flex;
    width: fit-content; /* Ajusta ao conteúdo */
  }

  .marquee-content-{{ current_section_id }} {
    display: inline-flex;
    align-items: center;
    animation: scroll-{{ current_section_id }} {{ speed }}s linear infinite;
    will-change: transform; /* Otimização de performance */
  }

  /* Duplicamos o conteúdo via CSS para evitar JavaScript */
  .marquee-content-{{ current_section_id }} .marquee-duplicate {
    display: inline-flex;
  }

  .marquee-item-{{ current_section_id }} {
    display: flex;
    align-items: center;
    color: {{ text_color }};
    font-size: {{ font_size }}px;
    font-weight: {{ font_weight }};
    flex-shrink: 0;
  }
  .marquee-item-text-a{
    margin-right: {{ item_spacing }}px;
  }
  .marquee-item-text-b{
    margin-left: {{ item_spacing }}px;
  }

  .marquee-icon-{{ current_section_id }} {
    margin-left: {{ item_spacing_bloco | divided_by: 2 }}px;
    color: {{ icon_color }};
    width: {{ icon_size }}px;
    height: {{ icon_size }}px;
    display: inline-flex;
    fill: currentColor;
  }
  .img-letreiro{
    width: {{icon_size }}px!important;
    height: {{icon_size }}px!important;
  }

  @keyframes scroll-{{ current_section_id }} {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); } /* Move apenas metade do conteúdo duplicado */
  }

  /* Versão reversa */
  {% if reverse %}
    .marquee-content-{{ current_section_id }} {
      animation: scroll-reverse-{{ current_section_id }} {{ speed }}s linear infinite;
    }
    @keyframes scroll-reverse-{{ current_section_id }} {
      0% { transform: translateX(-50%); }
      100% { transform: translateX(0); }
    }
  {% endif %}

  .marquee-container-{{ current_section_id }}.is-paused .marquee-content-{{ current_section_id }} {
    animation-play-state: paused;
  }
{%- endstyle -%}

<section class="marquee-section-{{ current_section_id }}">
  <div class="marquee-container-{{ current_section_id }}"
       data-section-id="{{ current_section_id }}"
       data-pause-on-hover="{{ pause_on_hover }}"
