<script>
document.addEventListener('DOMContentLoaded', function() {
  // Função para pausar no hover
  function initMarqueeHover(sectionId) {
    const marquee = document.querySelector(`.marquee-container-${sectionId}`);
    if (!marquee) return;

    const pauseOnHover = marquee.dataset.pauseOnHover === 'true';
    
    if (pauseOnHover) {
      marquee.addEventListener('mouseenter', () => {
        marquee.classList.add('is-paused');
      });
      marquee.addEventListener('mouseleave', () => {
        marquee.classList.remove('is-paused');
      });
    }
  }

  // Inicializa todos os letreiros
  document.querySelectorAll('[data-section-type="marquee-section"]').forEach(section => {
    initMarqueeHover(section.dataset.sectionId);
  });

  // Suporte ao editor do Shopify
  if (window.Shopify.designMode) {
    document.addEventListener('shopify:section:load', function(event) {
      initMarqueeHover(event.detail.sectionId);
    });
  }
});
</script>

{% schema %}
{
  "name": "Jejoom Letreiro 1",
  "tag": "section",
  "class": "section",
  "max_blocks": 10,
  "settings": [
    {
      "type": "paragraph",
      "content": "Use este letreiro para exibir mensagens importantes ou promoções."
    },
    {
      "type": "range",
      "id": "altura_letreiro",
      "label": "Altura da seção",
      "min": 40,
      "max": 140,
      "step": 1,
      "unit": "px",
      "default": 110
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Tamanho do ícone ou imagem",
      "min": 20,
      "max": 130,
      "step": 2,
      "unit": "px",
      "default": 70
    },
    {
      "type": "checkbox",
      "id": "reverse_icon",
      "label": "Posição do ícone (a direita [ativar])",
      "default": false
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Cor de fundo do letreiro",
      "default": "#DD1F36"
    },
    {
      "type": "color",
      "id": "text_color",
