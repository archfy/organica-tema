        <div style="color:#666;font-size:10px;">${variant}</div>
        <div style="font-weight:bold;font-size:13px;">R$ ${price}</div>
        <div style="margin-top: 5px;border: 1px solid #dedede;border-radius: 30px;width: 128px;">
          <button onclick="VZ.updateQty('${item.key}', ${Math.max(0, item.quantity - 1)})" style="border-color: #fff;width: 50px;height: 39px;background-color: #0000;margin: 0;color: #000;" aria-label="Diminuir quantidade">-</button>
          <span style="margin:0 4px;font-size:12px;">${item.quantity}</span>
          <button onclick="VZ.updateQty('${item.key}', ${item.quantity + 1})" style="border-color: #fff;width: 50px;height: 39px;background-color: #0000;margin: 0;color: #000;" aria-label="Aumentar quantidade">+</button>
        </div>
        ${isBrinde ? 
          '<span style="color:green;">Brinde!</span>' : 
          '<button onclick="VZ.updateQty(\'' + item.key + '\', 0)" style="font-size:11px;color:#2e2e2e;border:0;background:0;cursor:pointer;" aria-label="Remover item">Remover</button>'
        }
      </div>
      </div>
      <div>
      
    `;
    container.appendChild(div);
  });
},
  
atualizarBrindesCarrossel(brindes) {
  const container = document.getElementById('vz-brindes-container');
  const carrossel = document.getElementById('vz-brindes-carrossel');
  
  if (!container || !carrossel) return;

  if (brindes.length === 0) {
    container.style.display = 'none';
    return;
  }

  container.style.display = 'block';
  carrossel.innerHTML = '';

  brindes.forEach(brinde => {
    const slide = document.createElement('div');
    slide.className = 'vz-brinde-slide';
    const title = brinde.title || 'Brinde';
    const image = brinde.image || 'https://via.placeholder.com/50';
    slide.innerHTML = `
      <img src="${image}" alt="${title}">
      <div>
        <div style="font-weight:bold; color: var(--vz-cor-sucesso);">🎁 ${title}</div>
        <div style="font-size:12px; color:#666;">Brinde!</div>
      </div>
    `;
    carrossel.appendChild(slide);
  });

  // Reinicia posição
  carrossel.style.transform = 'translateX(0)';

  // Só roda automático se tiver mais de 1 brinde
  if (brindes.length > 1) {
    let current = 0;
    const interval = setInterval(() => {
      current = (current + 1) % brindes.length;
      carrossel.style.transform = `translateX(-${current * 100}%)`;
    }, 3000);

    if (this.brindeCarrosselInterval) {
      clearInterval(this.brindeCarrosselInterval);
    }
    this.brindeCarrosselInterval = interval;
  } else {
    if (this.brindeCarrosselInterval) {
      clearInterval(this.brindeCarrosselInterval);
      this.brindeCarrosselInterval = null;
    }
  }
},
  async updateQty(key, qty) {
    if (qty < 0) return;
    try {
      await fetch('/cart/change.js', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({id: key, quantity: qty})
      });
    } catch(e) {
      if (this.config.debug) console.error('Erro ao atualizar:', e);
    }
  },

  

  transformarEmChat() {
    document.getElementById('vz-gaveta').classList.remove('aberto');
    document.getElementById('vz-carrinho').classList.add('aberto');
    document.getElementById('vz-chat').classList.add('active');
    this.addMensagem('vendor', this.mensagens.chat[Math.floor(Math.random() * this.mensagens.chat.length)]);
  },
  addMensagem(tipo, texto) {
    const chat = document.getElementById('vz-messages');
    const msg = document.createElement('div');
    msg.className = 'vz-msg vz-msg-' + tipo;
    msg.textContent = texto;
    chat.appendChild(msg);
    chat.scrollTop = chat.scrollHeight;
  },
  enviarMensagem() {
    const input = document.getElementById('vz-input');
    const texto = input.value;
    if (!texto) return;
    this.addMensagem('customer', texto);
    input.value = '';
    setTimeout(() => {
      const respostas = {
        'frete': 'Frete grátis em compras acima de R$ ' + this.config.frete_gratis + '!',
        'prazo': 'Entregamos em 3-7 dias úteis!',
        'troca': 'Trocas em até 30 dias!',
        'pagamento': 'Aceitamos cartão, boleto e PIX!',
        'desconto': 'Use o cupom PRIMEIRA10 para 10% off!'
      };
      let resposta = 'Ótima pergunta! Entre em contato pelo WhatsApp para mais detalhes!';
      Object.keys(respostas).forEach(key => {
        if (texto.toLowerCase().includes(key)) {
          resposta = respostas[key];
        }
      });
      this.addMensagem('vendor', resposta);
    }, 1000);
  },
  celebrar() {
    if (!this.config.confetti) return;
    const canvas = document.getElementById('vz-confetti-canvas');
    const ctx = canvas.getContext('2d');
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
    const particles = [];
    for (let i = 0; i < 50; i++) {
      particles.push({
        x: Math.random() * canvas.width,
        y: 0,
        size: Math.random() * 10 + 5,
        speed: Math.random() * 5 + 2,
        color: `hsl(${Math.random() * 360}, 100%, 50%)`,
        rotation: Math.random() * 360,
        rotSpeed: Math.random() * 10 - 5
      });
    }
    function animate() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      particles.forEach(p => {
        p.y += p.speed;
        p.rotation += p.rotSpeed;
        ctx.save();
        ctx.translate(p.x, p.y);
        ctx.rotate(p.rotation * Math.PI / 180);
        ctx.fillStyle = p.color;
        ctx.fillRect(-p.size / 2, -p.size / 2, p.size, p.size);
        ctx.restore();
        if (p.y > canvas.height) p.y = 0;
      });
      requestAnimationFrame(animate);
    }
    animate();
    setTimeout(() => ctx.clearRect(0, 0, canvas.width, canvas.height), 3000);
  }
};

// NOVO: MÓDULO QUICK BUY
const VZQuickBuy = {
  productModal: null,
  currentProduct: null,
  
  init() {
    if (VZ.config.debug) console.log('⚡ Quick Buy iniciando...');
    this.setupQuickBuyButtons();
  },
  
  setupQuickBuyButtons() {
    // Aguarda um pouco pra garantir que a página carregou
    setTimeout(() => {
      // Seleciona todos os possíveis botões de compra
      const selectors = [
        '[data-add-to-cart]',
        '.btn-add-to-cart',
        '.quick-add',
        '.product-form__submit',
        'button[name="add"]',
        '.btn--add-to-cart',
        '.product__submit__add'
      ];
      
      const buttons = document.querySelectorAll(selectors.join(','));
      
      buttons.forEach(btn => {
        // Pula se já foi processado
        if (btn.dataset.vzProcessed) return;
        
        // Marca como processado
        btn.dataset.vzProcessed = 'true';
        
        // Clona o botão pra remover listeners antigos
        const newBtn = btn.cloneNode(true);
        btn.parentNode.replaceChild(newBtn, btn);
        
        newBtn.addEventListener('click', async (e) => {
          e.preventDefault();
          e.stopPropagation();
          
          const productHandle = this.extractProductHandle(newBtn);
          if (productHandle) {
            await this.openQuickBuy(productHandle);
          }
        });
      });
      
      if (VZ.config.debug) console.log(`⚡ ${buttons.length} botões interceptados`);
    }, 1000);
  },
  
  extractProductHandle(button) {
    // Tenta várias formas de pegar o handle
    const handle = 
      button.dataset.productHandle || 
      button.closest('[data-product-handle]')?.dataset.productHandle ||
      button.closest('[data-product-url]')?.dataset.productUrl?.match(/\/products\/([^\/\?]+)/)?.[1] ||
      button.closest('a[href*="/products/"]')?.href.match(/\/products\/([^\/\?]+)/)?.[1] ||
      button.closest('form[action*="/cart/add"]')?.action.match(/\/products\/([^\/\?]+)/)?.[1];
      
    return handle;
  },
  
  async openQuickBuy(productHandle) {
    try {
      const response = await fetch(`/products/${productHandle}.js`);
      const product = await response.json();
      
      this.currentProduct = product;
      this.populateModal(product);
      
      document.getElementById('vz-quickbuy').classList.add('aberto');
      document.getElementById('vz-overlay').style.display = 'block';
      document.getElementById('vz-mascote').style.display = 'none';
      
      VZ.falar('Escolhe aí rapidinho! ⚡');
      
    } catch (e) {
      console.error('Erro ao carregar produto:', e);
      VZ.falar('Ops! Erro ao carregar...');
    }
  },
  
  populateModal(product) {
  const infoEl = document.getElementById('qb-product-info');
  infoEl.innerHTML = `
    <img src="${product.featured_image}" alt="${product.title}" class="vz-qb-image">
    <div class="vz-qb-details">
      <h4 class="vz-qb-details-h4" style="margin: 0 0 10px 0;">${product.title}</h4>
      <p class="vz-qb-details-p" style="color: #B7BBC1; margin: 0;">Escolha sua opção:</p>
    </div>
  `;
  
  const priceEl = document.getElementById('qb-price');
  const price = (product.price / 100).toFixed(2);
  priceEl.innerHTML = `R$ ${price}`;
  
  const variantsEl = document.getElementById('qb-variants');
  variantsEl.innerHTML = '';
  
  // 🌿 BOTE FÉ: limita a 3 variantes
  const variantsToShow = product.variants.slice(0, 3);
  
  // 🌿 BOTE FÉ: percorre com índice pra saber se é primeiro/segundo
  variantsToShow.forEach((variant, index) => {
    const btn = document.createElement('button');
    btn.className = 'vz-qb-variant';
    
    // PEGA A IMAGEM CORRETA DA VARIANTE (seu código original)
    let variantImage = '';
    if (variant.featured_image) {
      variantImage = variant.featured_image.src || variant.featured_image;
    } else if (product.images && product.images[variant.position - 1]) {
      variantImage = product.images[variant.position - 1];
    } else if (variant.image_id && product.images) {
      const foundImage = product.images.find(img => {
        const imgId = typeof img === 'object' ? img.id : img;
        return imgId == variant.image_id;
      });
      if (foundImage) {
        variantImage = typeof foundImage === 'object' ? foundImage.src : foundImage;
      }
    }
    if (!variantImage) {
      variantImage = product.featured_image || product.images?.[0] || '';
    }
    if (variantImage && !variantImage.startsWith('http')) {
      variantImage = 'https:' + variantImage;
    }
    
    // 🌿 BOTE FÉ: lógica pura de JavaScript (sem Liquid!)
    const isFreteGratis = (variant.price > this.config.frete_gratis * 100); // frete_gratis em R$, variant.price em centavos
    const showFreteGratis = isFreteGratis && (index > 0); // não na primeira (index 0)
    const showMaisVendido = (index === 1); // só na segunda (index 1)
    
    // 🌿 BOTE FÉ: monta os labels dinamicamente
    let labelsHtml = '';
    if (showMaisVendido) {
      labelsHtml += `
        <div class="prod-x9-option-label prod-x9-option-label-bottom">
          Mais Vendido
        </div>
      `;
    }
    if (showFreteGratis) {
      labelsHtml += `
        <div class="prod-x9-option-label-2 prod-x9-option-label-bottom">
          Frete Grátis
        </div>
      `;
    }
    
    btn.innerHTML = `
      <div class="prod-x9-option-image desk-none">
        <img class="prod-x9-option"
          src="${variantImage}"
          srcset="${variantImage}"
          sizes="(max-width: 768px) 200px, 300px"
          loading="lazy"
          alt="${variant.title}">
      </div>   
      <div class="right-content">
        <div class="labels-container-x9">
          ${labelsHtml}
        </div>
        <div class="vz-qb-variant-bt">${variant.title}</div>
        <div class="prod-x9-option-image mobile-none">
          <img class="prod-x9-option"
            src="${variantImage}"
            srcset="${variantImage}"
            sizes="(max-width: 768px) 200px, 300px"
            loading="lazy"
            alt="${variant.title}">
        </div>
        <div class="mobile-none variant-price-wrapper text-center mt-2">
          <span class="block text-gray-600 text-[12px] text-juros">
            <span class="">3x sem juros de</span> 
            <span class="value-parcela">R$ ${(Math.round((variant.price / 3 / 100) * 100) / 100).toLocaleString('pt-BR', {minimumFractionDigits: 2, maximumFractionDigits: 2})}</span>
          </span>
          <span class="block font-bold text-juros-desk text-denavita-shopify text-[16px]" style="margin-top:-6px;text-align: center;">
            <span class="ou-a-vista"> ou</span> 
            <span class="value-vista">R$ ${(Math.round((variant.price / 100) * 100) / 100).toLocaleString('pt-BR', {minimumFractionDigits: 2, maximumFractionDigits: 2})}</span> 
            <span class="text-a-vista">á vista</span>
          </span>
        </div>
        <div class="desk-none variant-price-wrapper text-center mt-2">
          <span class="text-gray-600 text-[12px] text-juros">
            <span class="desk-none"> 3x de</span>
            <span class="mobile-none"> 3x sem juros de</span> 
            <span class="value-parcela">R$ ${(Math.round((variant.price / 3 / 100) * 100) / 100).toLocaleString('pt-BR', {minimumFractionDigits: 2, maximumFractionDigits: 2})}</span> 
            <span class="text-s-juros desk-none">s/ juros</span>
          </span>
          <span class="font-bold text-juros text-denavita-shopify text-[16px]">
            <span class="ou-a-vista"> ou</span> 
            <span class="value-vista">R$ ${(Math.round((variant.price / 100) * 100) / 100).toLocaleString('pt-BR', {minimumFractionDigits: 2, maximumFractionDigits: 2})}</span> 
            <span class="text-a-vista">á vista</span>
          </span>
        </div>
        ${variant.available ? '' : '<small style="color: red;">Esgotado</small>'}
      </div>
    `;
    
    if (variant.available) {
      btn.onclick = () => this.addVariantToCart(variant);
    } else {
      btn.style.opacity = '0.5';
      btn.style.cursor = 'not-allowed';
    }
    
    variantsEl.appendChild(btn);
  });
  
  if (product.variants.length > 3) {
    const moreLink = document.createElement('div');
    moreLink.style.marginTop = '10px';
    moreLink.innerHTML = `
      <a href="/products/${product.handle}" style="color: var(--vz-cor-sucesso);">
        Ver todas as ${product.variants.length} opções →
      </a>
    `;
    variantsEl.appendChild(moreLink);
  }
},
  
  async addVariantToCart(variant) {
    const btn = event.currentTarget;
    btn.classList.add('selecionado', 'adicionando');
    
    try {
      await fetch('/cart/add.js', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({
          id: variant.id,
          quantity: 1
        })
      });
      
      document.getElementById('qb-message').textContent = '✅ Adicionado!';
      
      setTimeout(() => {
        this.close();
        VZ.abrirCarrinho();
        document.getElementById('qb-message').textContent = ' ';
      }, 1500);
      
    } catch (e) {
      console.error('Erro:', e);
      btn.classList.remove('selecionado', 'adicionando');
      document.getElementById('qb-message').textContent = '❌ Erro';
    }
  },
  
  close() {
    document.getElementById('vz-quickbuy').classList.remove('aberto');
    document.getElementById('vz-overlay').style.display = 'none';
    
    setTimeout(() => {
      document.getElementById('vz-mascote').style.display = 'block';
      VZ.falar('Produto no carrinho! 🛒');
    }, 500);
  }
};

// INICIALIZAÇÃO COMPLETA
document.addEventListener('DOMContentLoaded', () => {
  if (VZ.config.enabled) {
    VZ.init();
    VZQuickBuy.init(); // NOVO!
  }
});

document.addEventListener('DOMContentLoaded', () => {
  if (VZ.config.enabled) {
    VZ.init();
  }
});
</script>
