<script>
const VZ = {
  config: {
    enabled: {{ section.settings.enabled | json }},
    delay: {{ section.settings.delay_segundos }}000,
    personality: {{ section.settings.personalidade | json }},
    modo_gaveta: {{ section.settings.modo_gaveta | json }},
    frete_gratis: {{ section.settings.valor_frete_gratis }},
    brinde1_valor: {{ section.settings.valor_brinde_1 }},
    brinde2_valor: {{ section.settings.valor_brinde_2 }},
    brinde3_valor: {{ section.settings.valor_brinde_3 }},
    brinde1_id: '{{ section.settings.produto_brinde_1.selected_or_first_available_variant.id }}',
    brinde2_id: '{{ section.settings.produto_brinde_2.selected_or_first_available_variant.id }}',
    brinde3_id: '{{ section.settings.produto_brinde_3.selected_or_first_available_variant.id }}',
    debug: {{ section.settings.debug_mode | json }},
    confetti: {{ section.settings.mostrar_confetti | json }},
    high_contrast: {{ section.settings.high_contrast_mode | json }}
  },
  brindeCarrosselInterval: null,
  ultimosBrindesKeys: '',
ultimoItemCount: 0,
  estado_atual: 'observando',
  tentativas_fechar: 0,
  modo_chat: false,
  carrinho_valor: 0,
  brindes_no_carrinho: {
    brinde1: false,
    brinde2: false,
    brinde3: false
  },
  cart_items: [],
  darkMode: false,
  brindeLock: false,
  brindeCarrosselInterval: null,
  mensagens: {
    inicial: {{ section.settings.mensagens_iniciais | split: '|' | json }},
    fechar: {{ section.settings.mensagens_fechar | split: '|' | json }},
    chat: ['Como posso ajudar?', 'Alguma dúvida?', 'Tô aqui pra ajudar!']
  },
  init() {
    if (this.config.debug) console.log('🏖️ Vendedor Zueiro iniciando...');
    if (this.config.high_contrast) {
      document.body.classList.add('high-contrast');
    }
    this.checarInfluencer();
    this.monitorarCarrinho();
    this.setupExitIntent();
    this.setupSwipe();
    this.setupBalaoContrast();
    setTimeout(() => this.aparecer(), this.config.delay);
  },
  setupBalaoContrast() {
    const balaoTexto = document.getElementById('vz-balao-texto');
    window.addEventListener('scroll', () => {
      const rect = balaoTexto.getBoundingClientRect();
      const x = rect.left + rect.width / 2;
      const y = rect.top + rect.height / 2;
      const elementUnder = document.elementFromPoint(x, y);
      if (elementUnder) {
        const bgColor = window.getComputedStyle(elementUnder).backgroundColor;
        const rgb = bgColor.match(/\d+/g);
        if (rgb) {
          const brightness = (parseInt(rgb[0]) * 299 + parseInt(rgb[1]) * 587 + parseInt(rgb[2]) * 114) / 1000;
          balaoTexto.style.color = brightness > 128 ? '#000' : '#fff';
        }
      }
    });
  },
  setupExitIntent() {
    document.addEventListener('mouseleave', (e) => {
      if (e.clientY < 0) {
        this.abrirCarrinho();
      }
    });
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'hidden') {
        this.abrirCarrinho();
      }
    });
  },
  setupSwipe() {
    const carrossel = document.getElementById('vz-carrossel');
    if (carrossel) {
      let startX;
      carrossel.addEventListener('touchstart', (e) => {
        startX = e.touches[0].clientX;
      });
      carrossel.addEventListener('touchmove', (e) => {
        const diffX = startX - e.touches[0].clientX;
        carrossel.scrollLeft += diffX;
        startX = e.touches[0].clientX;
      });
    }
  },
  toggleDarkMode() {
    this.darkMode = !this.darkMode;
    document.body.classList.toggle('dark-mode', this.darkMode);
  },
  switchTab(tabId) {
    document.querySelectorAll('.vz-tab').forEach(tab => tab.classList.remove('active'));
    document.querySelectorAll('.vz-tab-content').forEach(content => content.classList.remove('active'));
    event.target.classList.add('active');
    document.getElementById(`tab-${tabId}`).classList.add('active');
  },
  checarInfluencer() {
    const params = new URLSearchParams(window.location.search);
    if (params.get('ref') && params.get('vz_mode') === 'custom') {
      if (this.config.debug) console.log('Modo influencer detectado!');
      this.config.personality = 'influencer';
    }
  },
  aparecer() {
    const mascote = document.getElementById('vz-mascote');
    mascote.classList.add('visivel');
    const msg = this.mensagens.inicial[Math.floor(Math.random() * this.mensagens.inicial.length)];
    this.falar(msg);
  },
  falar(texto) {
    const balao = document.getElementById('vz-balao-texto');
    if (!balao) return;
    balao.innerHTML = '';
    let i = 0;
    const digitar = setInterval(() => {
      if (i < texto.length) {
        balao.innerHTML += texto[i];
        i++;
      } else {
        clearInterval(digitar);
      }
    }, 50);
  },
  tentarFechar() {
    this.tentativas_fechar++;
    if (this.tentativas_fechar === 1) {
      const msg = this.mensagens.fechar[Math.floor(Math.random() * this.mensagens.fechar.length)];
      this.falar(msg);
      const mascote = document.getElementById('vz-mascote');
      mascote.style.opacity = 0.5;
      setTimeout(() => {
        mascote.style.opacity = 1;
      }, 500);
    } else if (this.tentativas_fechar === 2) {
      this.abrirGaveta();
    } else if (this.config.chat_enabled) {
      this.transformarEmChat();
    } else {
      document.getElementById('vz-mascote').style.display = 'none';
    }
  },
  abrirGaveta() {
    document.getElementById('vz-gaveta').classList.add('aberto');
    document.getElementById('vz-overlay').style.display = 'block';
    document.getElementById('vz-mascote').style.display = 'none';
    this.atualizarProgresso();
    if (this.config.modo_gaveta === 'trilha') {
      this.atualizarTrilha();
      document.querySelector('.vz-chat-btn').style.display = 'none';
    }
  },
  fecharGaveta() {
    document.getElementById('vz-gaveta').classList.remove('aberto');
    document.getElementById('vz-overlay').style.display = 'none';
    document.getElementById('vz-mascote').style.display = 'block';
    document.getElementById('vz-mascote').classList.add('visivel');
  },
  async monitorarCarrinho() {
    setInterval(async () => {
      try {
        document.getElementById('vz-loading').style.display = 'block';
        const response = await fetch('/cart.js');
        const cart = await response.json();
        this.processarCarrinho(cart);
        document.getElementById('vz-loading').style.display = 'none';
      } catch(e) {
        if (this.config.debug) console.error('Erro ao monitorar carrinho:', e);
        document.getElementById('vz-loading').style.display = 'none';
      }
    }, 2000);
  },
  processarCarrinho(cart) {
  const valor_sem_brindes = this.calcularValorSemBrindes(cart);
  const brindesAtuais = cart.items
    .filter(item => item.properties && item.properties._brinde)
    .map(b => b.key)
    .sort()
    .join(',');

  // 🌿 BOTE FÉ: só atualiza UI se algo mudou
  const precisaAtualizar = (
    valor_sem_brindes !== this.carrinho_valor ||
    brindesAtuais !== this.ultimosBrindesKeys ||
    cart.item_count !== this.ultimoItemCount
  );

  this.carrinho_valor = valor_sem_brindes;
  this.cart_items = cart.items;
  this.ultimosBrindesKeys = brindesAtuais;
  this.ultimoItemCount = cart.item_count;

  if (precisaAtualizar) {
    this.atualizarProgresso();
    if (this.config.modo_gaveta === 'trilha') {
      this.atualizarTrilha();
    }
    this.gerenciarBrindes(valor_sem_brindes, cart);
    this.atualizarCarrinhoUI(cart);
    this.atualizarBadge(cart.item_count);
    //this.personalizeTrilha();
  }
},

  personalizeTrilha() {
  if (this.cart_items.length > 0) {
    const category = this.cart_items[0].product_type || 'geral';
    document.querySelectorAll('.vz-trilha-titulo').forEach(titulo => {
      // 🌿 BOTE FÉ: só adiciona se ainda não tiver o sufixo
      const suffix = ` (para ${category})`;
      if (!titulo.textContent.endsWith(suffix)) {
        titulo.textContent = titulo.textContent.replace(/ \(para .*\)$/, '') + suffix;
      }
    });
  }
},
  atualizarBadge(count) {
    document.getElementById('vz-badge').textContent = count;
  },
  calcularValorSemBrindes(cart) {
    let total = 0;
    cart.items.forEach(item => {
      if (!item.properties || !item.properties._brinde) {
        total += item.line_price;
      }
    });
    return total / 100;
  },
  async gerenciarBrindes(valor, cart) {
    if (this.brindeLock) return;
    this.brindeLock = true;

    try {
      const tem_brinde1 = cart.items.some(item => 
        item.properties && item.properties._brinde && item.properties._numero == 1
      );
      const tem_brinde2 = cart.items.some(item => 
        item.properties && item.properties._brinde && item.properties._numero == 2
      );
      const tem_brinde3 = cart.items.some(item => 
        item.properties && item.properties._brinde && item.properties._numero == 3
      );

      if (valor >= this.config.brinde1_valor && !tem_brinde1) {
        await this.adicionarBrinde(1);
      } else if (valor < this.config.brinde1_valor && tem_brinde1) {
        await this.removerBrinde(1, cart);
      }

      if (valor >= this.config.brinde2_valor && !tem_brinde2) {
        await this.adicionarBrinde(2);
      } else if (valor < this.config.brinde2_valor && tem_brinde2) {
        await this.removerBrinde(2, cart);
      }

      if (valor >= this.config.brinde3_valor && !tem_brinde3) {
        await this.adicionarBrinde(3);
      } else if (valor < this.config.brinde3_valor && tem_brinde3) {
        await this.removerBrinde(3, cart);
      }
    } catch (e) {
      if (this.config.debug) console.error('Erro em gerenciarBrindes:', e);
    } finally {
      setTimeout(() => {
        this.brindeLock = false;
      }, 1500);
    }
  },
  async adicionarBrinde(numero) {
    let variant_id;
    if (numero === 1) variant_id = this.config.brinde1_id;
    else if (numero === 2) variant_id = this.config.brinde2_id;
    else if (numero === 3) variant_id = this.config.brinde3_id;
    if (!variant_id) return;
    try {
      await fetch('/cart/add.js', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({
          id: variant_id,
          quantity: 1,
          properties: {
            '_brinde': true,
            '_numero': numero
          }
        })
      });
      this.celebrar();
      this.falar(`Você ganhou o brinde ${numero}! 🎁`);
    } catch(e) {
      if (this.config.debug) console.error('Erro ao adicionar brinde:', e);
    }
  },
  async removerBrinde(numero, cart) {
    let variant_id;
    if (numero === 1) variant_id = this.config.brinde1_id;
    else if (numero === 2) variant_id = this.config.brinde2_id;
    else if (numero === 3) variant_id = this.config.brinde3_id;
    const item = cart.items.find(i => 
      i.properties && i.properties._brinde && i.properties._numero == numero
    );
    if (!item) return;
    try {
      await fetch('/cart/change.js', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({
          id: item.key,
          quantity: 0
        })
      });
      this.falar(`Você perdeu o brinde ${numero}... 😢`);
    } catch(e) {
      if (this.config.debug) console.error('Erro ao remover brinde:', e);
    }
  },
  atualizarProgresso() {
    const valor = this.carrinho_valor;
    const barra = document.querySelectorAll('.vz-progress-fill');
    const msgs = document.querySelectorAll('.vz-progress-msg');
    let percent = 0;
    let mensagem = '';
    if (valor < this.config.frete_gratis) {
      percent = (valor / this.config.frete_gratis) * 25;
      const falta = (this.config.frete_gratis - valor).toFixed(2);
      mensagem = `Falta R$ ${falta} pro frete grátis!`;
    } else if (valor < this.config.brinde1_valor) {
      percent = 25 + ((valor - this.config.frete_gratis) / (this.config.brinde1_valor - this.config.frete_gratis)) * 25;
      const falta = (this.config.brinde1_valor - valor).toFixed(2);
      mensagem = `Frete grátis ativo! Mais R$ ${falta} = brinde 1 🎁`;
      document.querySelector('.vz-milestone-1').classList.add('achieved');
    } else if (valor < this.config.brinde2_valor) {
      percent = 50 + ((valor - this.config.brinde1_valor) / (this.config.brinde2_valor - this.config.brinde1_valor)) * 25;
      const falta = (this.config.brinde2_valor - valor).toFixed(2);
      mensagem = `1 brinde garantido! Mais R$ ${falta} para o brinde 2!`;
      document.querySelector('.vz-milestone-1').classList.add('achieved');
      document.querySelector('.vz-milestone-2').classList.add('achieved');
    } else if (valor < this.config.brinde3_valor) {
      percent = 75 + ((valor - this.config.brinde2_valor) / (this.config.brinde3_valor - this.config.brinde2_valor)) * 25;
      const falta = (this.config.brinde3_valor - valor).toFixed(2);
      mensagem = `2 brindes garantidos! Mais R$ ${falta} para o brinde 3!`;
      document.querySelector('.vz-milestone-1').classList.add('achieved');
      document.querySelector('.vz-milestone-2').classList.add('achieved');
      document.querySelector('.vz-milestone-3').classList.add('achieved');
    } else {
      percent = 100;
      mensagem = `Parabéns! Todos os brindes desbloqueados! 🎊`;
      document.querySelectorAll('.vz-milestone').forEach(m => m.classList.add('achieved'));
    }
    barra.forEach(b => b.style.width = percent + '%');
    msgs.forEach(m => m.textContent = mensagem);
  },
  atualizarTrilha() {
    const valor = this.carrinho_valor;
    const items = document.querySelectorAll('.vz-trilha-item');
    const progresso = document.getElementById('vz-trilha-progresso');
    let percentualProgresso = 0;
    let itemsConquistados = 0;
    items.forEach((item, index) => {
      const valorItem = parseFloat(item.dataset.valor);
      if (valor >= valorItem) {
        item.classList.add('conquistado');
        item.classList.remove('ativo');
        itemsConquistados++;
      } else if (index === itemsConquistados) {
        item.classList.add('ativo');
        item.classList.remove('conquistado');
      } else {
        item.classList.remove('ativo', 'conquistado');
      }
    });
    if (valor >= this.config.brinde3_valor) {
      percentualProgresso = 100;
    } else if (valor >= this.config.brinde2_valor) {
      percentualProgresso = 75;
    } else if (valor >= this.config.brinde1_valor) {
      percentualProgresso = 50;
    } else if (valor >= this.config.frete_gratis) {
      percentualProgresso = 25;
    } else {
      percentualProgresso = (valor / this.config.frete_gratis) * 25;
    }
    if (progresso) {
      progresso.style.width = percentualProgresso + '%';
    }
  },
  async adicionarAoCarrinho(variant_id) {
    try {
      await fetch('/cart/add.js', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({
          id: variant_id,
          quantity: 1
        })
      });
      this.abrirCarrinho();
      this.falar('Produto adicionado! 🛒');
    } catch(e) {
      if (this.config.debug) console.error('Erro ao adicionar:', e);
    }
  },
  abrirCarrinho() {
    document.getElementById('vz-carrinho').classList.add('aberto');
  },
  fecharCarrinho() {
    document.getElementById('vz-carrinho').classList.remove('aberto');
  },
  atualizarCarrinhoUI(cart) {
  document.getElementById('vz-cart-count').textContent = cart.item_count;
  document.getElementById('vz-cart-total').textContent = 'R$ ' + (cart.total_price / 100).toFixed(2);

  // 🌿 Separa brindes dos itens normais
