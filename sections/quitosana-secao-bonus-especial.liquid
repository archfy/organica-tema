{% schema %}
{
  "name": "Secao Bonus Especial",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "product",
      "id": "x11selected_product",
      "label": "Produto para metacampos",
      "info": "Selecione o produto que contém os metacampos"
    },
    {
      "type": "header",
      "content": "Configurações Gerais"
    },
    {
      "type": "color",
      "id": "x11background_color",
      "label": "Cor de fundo da seção",
      "default": "#FFF4D5"
    },
    {
      "type": "color",
      "id": "x11cor_borda_color",
      "label": "Cor da borda",
      "default": "#4bb000"
    },
    {
      "type": "range",
      "id": "x11border_radius",
      "label": "Arredondamento da seção (px)",
      "min": 0,
      "max": 50,
      "step": 1,
      "default": 20
    },
    {
      "type": "header",
      "content": "Estilo do Título Principal"
    },
    {
      "type": "color",
      "id": "x11title_color",
      "label": "Cor do título",
      "default": "#333333"
    },
    {
      "type": "range",
      "id": "x11title_size",
      "label": "Tamanho do título (px)",
      "min": 24,
      "max": 60,
      "step": 1,
      "default": 36
    },
    {
      "type": "select",
      "id": "x11title_weight",
      "label": "Espessura do título",
      "options": [
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi-bold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra-bold" }
      ],
      "default": "700"
    },
    {
      "type": "range",
      "id": "x11title_spacing",
      "label": "Espaçamento inferior (px)",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 30
    },
    {
      "type": "header",
      "content": "Estilo do Subtítulo"
    },
    {
      "type": "color",
      "id": "x11subtitle_color",
      "label": "Cor do subtítulo",
      "default": "#59000B"
    },
    {
      "type": "range",
      "id": "x11subtitle_size",
      "label": "Tamanho do subtítulo (px)",
      "min": 14,
      "max": 32,
      "step": 1,
      "default": 22
    },
