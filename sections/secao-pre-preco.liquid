{% schema %}
{
  "name": "Secao Pré-Precos",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Configurações Gerais"
    },
    {
      "type": "color",
      "id": "x195background_color",
      "label": "Cor de fundo da seção",
      "default": "#FFF4D5"
    },
    {
      "type": "color",
      "id": "x195cor_borda_color",
      "label": "Cor da borda",
      "default": "#4bb000"
    },
    {
      "type": "range",
      "id": "x195border_radius",
      "label": "Arredondamento da seção (px)",
      "min": 0,
      "max": 50,
      "step": 1,
      "default": 20
    },
    {
      "type": "range",
      "id": "x195border_line",
      "label": "Espessura da borda (px)",
      "min": 0,
      "max": 50,
      "step": 1,
      "default": 1
    },
    {
      "type": "header",
      "content": "Conteúdo Principal do Bloco"
    },
    {
      "type": "textarea",
      "id": "x195titulo_text",
      "label": "Texto do Título",
      "default": "Escolha seu Kit."
    },
    {
      "type": "color",
      "id": "x195titulo_text_color",
      "label": "Cor do texto",
      "default": "#4bb000"
    },  
    {
      "type": "select",
      "id": "x195titulo_weight",
      "label": "Espessura do título",
      "options": [
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi-bold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra-bold" }
      ],
      "default": "600"
    },   
     {
      "type": "range",
      "id": "x195titulo_size",
      "label": "Tamanho da fonte (px)",
      "min": 10,
      "max": 55,
      "step": 1,
      "default": 22
    },
    {
      "type": "range",
      "id": "x195titulo_margin",
      "label": "Espaçamento entre título e subtítulo (px)",
      "min": -50,
      "max": 50,
      "step": 1,
      "default": 20
    },
    {
      "type": "range",
      "id": "x195titulo_margin_desktop",
      "label": "Espaçamento entre título e subtítulo (desktop)",
      "min": -50,
      "max": 50,
      "step": 1,
      "default": 20
    },
    {
      "type": "textarea",
      "id": "x195subtitulo_text",
      "label": "Texto do Subtítulo",
      "default": "Preços especiais, por tempo limitado."
    },
    {
      "type": "color",
      "id": "x195subtitulo_text_color",
      "label": "Cor do subtítulo",
      "default": "#4bb000"
    },
    {
      "type": "select",
      "id": "x195subtitulo_weight",
      "label": "Espessura do Subtítulo",
      "options": [
