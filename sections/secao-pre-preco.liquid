{% comment %}
  Template de página personalizada com bloco de conteúdo dividido
  Estrutura:
  - Título da página
  - Bloco personalizado com:
    - Título e subtítulo centralizados
    - Duas colunas (50% cada) com:
      - Título e subtítulo à esquerda
      - Imagem à direita
    - Borda e cor de fundo
{% endcomment %}

{%- style -%}
/* ========== [INÍCIO] CSS ORIGINAL (MANTIDO INTEGRALMENTE) ========== */
.main-title-espacamento{
      margin-bottom: {{section.settings.x195titulo_margin_desktop}}px;
} 
.x195custom-pagex5 {
  margin: 0 auto;
  font-family: inherit;
}

.x195custom-page__title {
  text-align: center;
  font-size: 36px;
  margin-bottom: 30px;
  color: #333;
}

.x195content-blockx5 {
  background-color: #fff4d5;
  margin: 10px;
  width: auto;
  border-radius: 20px;
  padding-top: 0px !important;
}


.x195content-blockx5__header {
  text-align: center;
  margin-bottom: 0px;
  padding-top: 60px;
}

.x195content-blockx5__title {
  font-size: 28px;
  font-weight: bold;
  margin-bottom: 20px;
  color: {{ section.settings.x195heading_color }};
}

.x195content-blockx5__subtitle {
  color: {{ section.settings.x195subheading_color }};
  max-width: 800px;
  margin: 0 auto;
  color: #000;
  font-size: 16px;
  font-style: normal;
  font-weight: 400;
  letter-spacing: 0;
  line-height: 1.x115;
  padding: 0;
  text-align: center;
  text-decoration: none;
  text-transform: none;
  word-spacing: 0;
}

.x195content-blockx5__columns {
  
}

.x195content-blockx5__column {
  margin-top: 30px;
  flex: 0 0 calc(50% - 10px);
  display: flex;
  border: {{ section.settings.x195border_width }}px solid {{ section.settings.x195border_color }};
  border-radius: {{ section.settings.x195border_radius }}px;
  overflow: hidden;
  background-color: {{ section.settings.x195background_color }};
}

.x195content-blockx5__column-content {
 
}

.x195content-blockx5__column-title {
  color: #59000b;
  font-size: 16px;
  font-style: normal;
  font-weight: 400;
  letter-spacing: 0;
  line-height: 1.x105;
  padding: 0;
  text-align: left;
  text-decoration: none;
  text-transform: none;
  word-spacing: 0;
  margin: 0 5px 0 0;
  opacity: 1;
  position: relative;
  color: {{ section.settings.x195column_heading_color1 }};
  font-size: {{ section.settings.x195column_heading_size }}px;
  font-weight: {{ section.settings.x195column_heading_weight }};
  letter-spacing: {{ section.settings.x195column_heading_spacing }}px;
}

.x195content-blockx5__column-subtitle {
  color: {{ section.settings.x195column_subtitle_color }} !important;
  font-size: {{ section.settings.x195column_subtitle_size }}px !important;
  font-weight: {{ section.settings.x195column_subtitle_weight }};
  line-height: {{ section.settings.x195column_subtitle_line_height }} !important;
  font-style: normal !important;
  letter-spacing: 0 !important;
  text-align: left !important;
  text-decoration: none !important;
  text-transform: none !important;
  word-spacing: 0 !important;
  font-weight: 400;
  padding: 0;
  opacity: 1;
  position: relative;
}

.x195content-blockx5__column-image {
  flex: 0 0 160px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding-right: 30px;
  background-color: {{ section.settings.x195background_color }};
  border-radius: 12px;
  overflow: hidden;
}

.x195content-blockx5__column-image img {
  max-width: 100%;
  height: auto;
  display: block;
  object-fit: cover;
  border-radius: inherit;
}

.x195pe-imagex5 {
  padding-top: 40px;
  line-height: 0;
  overflow: hidden;
  text-align: center;
}

.x195pe-image img {
  border-radius: 0;
  display: inline-block;
  height: auto;
  max-height: inherit;
  width: 40%;
}

.x195custom-button-containerx5 {
  text-align: center;
  width: 100%;
}

.x195custom-button {
  display: inline-block;
  padding: 18px 100px;
  background-color: {{ section.settings.x195button_bg_color }};
  color: {{ section.settings.x195button_text_color }} !important;
  text-decoration: none;
  font-weight: bold;
  border-radius: 50px;
  transition: all 0.x113s ease;
  border: none;
  cursor: pointer;
  font-size: 16px;
  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.x111);
 margin-bottom: 60px;
}

.x195custom-button:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 12px rgba(0, 0, 0, 0.x1115);
  opacity: 0.x119;
}


.x195intro-headerx5 {
  text-align: center;
  margin-bottom: 3rem;
}

.x195intro-titlex5 {
  color: {{ settings.x195heading_color }};
  font-size: {{ settings.x195column_subtitle_size }}px;
  font-weight: {{ settings.x195column_subtitle_weight }};
  letter-spacing: {{ settings.x195column_heading_spacing }}px;
  margin: 0;
}

.x195intro-contentx5 {
  display: flex;
  flex-wrap: wrap;
  gap: {{ settings.x195image_spacing }}px;
  padding-left: 30px;
  padding-right: 30px;

}

.x195content-colx5 {
  flex: 1;
  min-width: 300px;
  border: 1px solid {{ section.settings.x195cor_borda_color }}!important;
  border-radius: 12px;
  box-sizing: border-box;
  

}

.x195intro-subtitlex5,
.x195benefits-titlex5,
.x195benefits-subtitlex5 {
  color: {{ settings.x195column_heading_color }};
  font-size: {{ settings.x195column_heading_size }}px;
  font-weight: {{ settings.x195column_heading_weight }};
  
  line-height: {{ settings.x195column_subtitle_line_height }};
}

.x195intro-textx5 {
  color: {{ settings.x195column_text_color }};
  font-size: {{ settings.x195column_subtitle_size }}px;
  line-height: 1.x116;
}

.x195intro-imagex5 {
  margin: {{ settings.x195image_spacing }}px 0;
}

.x195intro-imagex5 img {
  width: 100%;
  height: auto;
  border-radius: {{ settings.x195image_border_radius }}px;
}

.x195intro-ctax5 {
  text-align: center;
}

.x195cta-buttonx5 {
  display: inline-block;
  padding: 12px 24px;
  background: {{ settings.x195button_bg_color }};
  color: {{ settings.x195button_text_color }};
  font-size: {{ settings.x195column_heading_size }}px;
  text-decoration: none;
  border-radius: {{ settings.x195button_radius }}px;
  transition: all 0.x113s ease;
}

.x195cta-button:hover {
  opacity: 0.x119;
  transform: translateY(-2px);
}

/* ========== [FIM] CSS ORIGINAL ========== */

/* ========== [INÍCIO] MODIFICAÇÕES SOLICITADAS ========== */
/* [1] TÍTULO PRINCIPAL */
.x195intro-titlex5 {
  max-width: 33.x1033%;
  margin-left: auto;
  margin-right: auto;
  letter-spacing: 0.x1025px !important;
  line-height: 1.x1015 !important;
 
}

@media (max-width: 768px) {
  .x195intro-titlex5 {
    max-width: calc(100% - 80px);
    padding: 0 40px !important;
  }
}

/* [2] COLUNA ESQUERDA */
@media (min-width: 769px) {
  .x195content-colx5:first-child {
    margin-right: 50px !important;
  }
  .x195content-blockx5 {
height: auto;
}
}

.x195intro-imagex5 {
  margin-bottom: 40px !important;
}

.x195intro-imagex5 img {
  height: 97%;
  width: auto !important;
  background-color: {{ section.settings.x195background_color }} !important;
}

/* [3] RICH TEXT */
.x195content-blockx5__column-subtitle {
  text-align: left !important;
  
}

.x195content-blockx5__column-subtitle br {
  display: block;
  margin-bottom: 12px;
}

/* ========== [FIM] MODIFICAÇÕES SOLICITADAS ========== */

/* ========== RESPONSIVIDADE ORIGINAL ========== */
@media (max-width: 768px) {
  .x195content-blockx5__column {
    flex: 0 0 100%;
    margin-top: 0px;
  }
  .x195content-blockx5__column-image {
    flex: 0 0 100px;
  }
  .x195content-blockx5__column-image img {
    width: 100%;
  }
  .x195content-blockx5 {
    margin-bottom: 30px;
  }
  .x195pe-image img {
    border-radius: 0;
    display: inline-block;
    height: auto;
    max-height: inherit;
    width: 100%;
    padding-left: 30px;
    padding-right: 30px;
  }
  .x195content-blockx5__column {
    flex-direction: column !important;
  }
  .x195content-blockx5__column-image {
    flex: 0 0 auto !important;
    width: 100%;
    padding: 30px;
    padding-top: 0px;
    border-radius: 8px;
    background-color: {{ section.settings.x195background_color }};
    order: 2;
  }
  
  .x195content-blockx5__column-content {
    padding: 30px;
    padding-bottom: 10px;
    width: 100%;
  }
  .x195custom-button {
    padding: 15px 60px;
    width: 90%;
    max-width: 300px;
    margin-top: 0px;
    
  }
}

@media (max-width: {{ settings.x195mobile_breakpoint }}px) {
  .x195intro-contentx5 {
    flex-direction: column;
  }
  .x195content-colx5 {
    width: 100%;
    margin-bottom: 20px;
  }
}
{%- endstyle -%}

