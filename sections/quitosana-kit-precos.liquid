{% comment %}
  Seção Shopify: Abas de Produtos/Sabores - Kit de Preços (Refatorado para BLOCKS e Ajustes Finais)
  - Estrutura dinâmica para até 5 abas/sabores, gerenciadas por blocks.
  - Cada aba pode ter até 3 opções de compra (imagem, preço, botão, etc.) configuráveis dentro do próprio bloco da aba.
  - Customização total via editor de tema para cada aba e suas opções.
  - CSS independente e otimizado para equilíbrio visual.
  - JavaScript puro, sem conflito, adaptado para a nova estrutura de blocks.
  - Comentários para integração dos links de checkout.
  - Erros corrigidos em HTML, CSS, Liquid e Schema.
  - Melhoria significativa na usabilidade do editor do tema.
  - Adicionado controle de largura (%) e altura máxima (px) de imagem (Desktop/Mobile) via settings.
  - Corrigido o problema de preenchimento do botão.
  - Imagens centralizadas dentro dos cards.
  - Adicionados dois campos de texto customizáveis acima de cada imagem, com controle total de estilo (fonte, cor, background, border-radius).
  - **CORRIGIDO: Erro de sintaxe Liquid em acesso dinâmico a configurações.**
{% endcomment %}

{%- style -%}
/* ========== [INÍCIO] CSS da Seção Shopify: Abas de Produtos/Sabores ========== */
.x9-shopify-tabs-section-{{ section.id }} {
  font-family: inherit;
  padding: {{ section.settings.section_padding_top }}px 0 {{ section.settings.section_padding_bottom }}px 0;
  background: {{ section.settings.section_bg_color }};
}

.x9-tabs-area-{{ section.id }} {
  border: {{ section.settings.border_width }}px solid {{ section.settings.border_color | default: '#e0e0e0' }};
  border-radius: {{ section.settings.border_radius }}px;
  padding: {{ section.settings.area_padding_top }}px {{ section.settings.area_padding_side }}px {{ section.settings.area_padding_bottom }}px {{ section.settings.area_padding_side }}px;
  background: {{ section.settings.area_bg_color }};
  box-shadow: 0 2px 8px rgba(0,0,0,0.04);
  max-width: 1200px; /* Máximo de largura para o container principal */
  margin: 0 auto; /* Centraliza o container principal */
  padding-left: max({{ section.settings.area_padding_side }}px, env(safe-area-inset-left));
  padding-right: max({{ section.settings.area_padding_side }}px, env(safe-area-inset-right));
}

.x9-tabs-header {
  display: flex;
  justify-content: center; /* Centraliza as abas */
  flex-wrap: wrap; /* Permite que as abas quebrem a linha em telas menores */
  gap: 2px;
  margin-bottom: 20px;
  border-bottom: 1px solid {{ section.settings.tab_border_color | default: '#e0e0e0' }};
  overflow-x: auto; /* Adiciona scroll horizontal se as abas excederem o espaço */
  -webkit-overflow-scrolling: touch; /* Melhora o scroll em iOS */
}

.x9-tab-button {
  background-color: {{ section.settings.tab_bg_color | default: '#f0f0f0' }};
  color: {{ section.settings.tab_text_color | default: '#555' }};
  border: 1px solid {{ section.settings.tab_border_color | default: '#e0e0e0' }};
  border-bottom: none; /* Remove a borda inferior para visual de aba */
  padding: 10px 18px;
  cursor: pointer;
  font-size: {{ section.settings.tab_font_size }}px;
  font-weight: {{ section.settings.tab_font_weight }};
  transition: all 0.3s ease;
  border-top-left-radius: 8px;
  border-top-right-radius: 8px;
  white-space: nowrap; /* Evita que o texto da aba quebre */
}

.x9-tab-button:hover:not(.active) {
  background-color: {{ section.settings.tab_hover_bg_color | default: '#e9e9e9' }};
  color: {{ section.settings.tab_hover_text_color | default: '#333' }};
}

.x9-tab-button.active {
  background-color: {{ section.settings.tab_active_bg_color | default: '#fff' }};
  color: {{ section.settings.tab_active_text_color | default: '#333' }};
  border-color: {{ section.settings.tab_active_border_color | default: '#d0d0d0' }};
  font-weight: {{ section.settings.tab_active_font_weight }};
  position: relative; /* Para a borda inferior simulada */
  z-index: 1; /* Para sobrepor a borda inferior do header */
}

.x9-tab-button.active::after { /* Simula a linha inferior da aba ativa */
  content: '';
  position: absolute;
  bottom: -1px; /* Alinha com a borda do header */
  left: 0;
  width: 100%;
  height: 1px; /* Espessura da linha */
  background-color: {{ section.settings.tab_active_bg_color | default: '#fff' }}; /* Cor da linha */
  z-index: 2;
}

.x9-tabs-content {
  position: relative;
  min-height: 200px; /* Garante que o container de conteúdo não colapse */
}

.x9-tab-pane {
  display: none;
  opacity: 0;
  transition: opacity 0.5s ease-in-out;
  animation: fadeIn 0.5s forwards;
  position: absolute; /* Permite que os panes se sobreponham e ocultem */
  top: 0;
  left: 0;
  width: 100%;
}

.x9-tab-pane.show {
  display: block;
  opacity: 1;
  position: relative; /* Retorna ao fluxo normal quando ativo */
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.x9-product-options-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); /* Adaptável para 3 colunas */
  gap: 20px;
  justify-content: center;
  align-items: stretch; /* Garante que os cards tenham a mesma altura */
  padding: 0 10px; /* Pequeno padding para evitar que os cards toquem as bordas laterais */
}

.x9-product-option-card {
  background: {{ section.settings.card_bg_color | default: '#fff' }};
  border: 1px solid {{ section.settings.card_border_color | default: '#e0e0e0' }};
  border-radius: {{ section.settings.card_border_radius }}px;
  padding: 20px;
  text-align: center;
  display: flex;
  flex-direction: column;
  justify-content: space-between; /* Espaça o conteúdo */
  align-items: center; /* CENTRALIZA ITENS FLEX HORIZONTALMENTE: AQUI ESTÁ A CHAVE PARA IMAGENS CENTRALIZADAS */
  box-shadow: 0 2px 5px rgba(0,0,0,0.02);
  transition: transform 0.2s ease;
}

.x9-product-option-card:hover {
  transform: translateY(-3px);
}

/* Base style for the new labels */
.x9-option-label {
  margin-bottom: 5px; /* Adjust spacing between labels and image */
  width: fit-content; /* Ensure background color wraps content */
  max-width: 100%; /* Prevent overflow */
  text-align: center;
  /* display: block; -- Já é um div, então é block por padrão. */
}

.x9-option-image {
  margin-bottom: 15px;
  display: flex; /* Já é um flex container para a imagem dentro dele */
  align-items: center;
  justify-content: center;
  /* Customização de largura em % e altura máxima para desktop */
  width: {{ section.settings.option_image_width_desktop }}%;
  max-height: {{ section.settings.option_image_height_desktop }}px;
  height: auto; /* Permite que max-height funcione corretamente */
}
.x9-option-image img {
  max-width: 100%;
  max-height: 100%;
  object-fit: contain;
  border-radius: 12px;
}

.x9-option-title {
  font-size: {{ section.settings.card_title_font_size }}px;
  font-weight: {{ section.settings.card_title_font_weight }};
  color: {{ section.settings.card_title_color | default: '#333' }};
  margin: 10px;
  line-height: 1.2;
}

.x9-option-old-price {
  font-size: {{ section.settings.old_price_font_size }}px;
  color: {{ section.settings.old_price_color | default: '#999' }};
  text-decoration: line-through;
  margin-bottom: 5px;
}

.x9-option-price {
  font-size: {{ section.settings.price_font_size }}px;
  font-weight: {{ section.settings.price_font_weight }};
  color: {{ section.settings.price_color | default: '#e74c3c' }};
  margin-bottom: 10px;
  line-height: 1;
}

.x9-option-discount {
  font-size: {{ section.settings.discount_font_size }}px;
  color: {{ section.settings.discount_color | default: '#fff' }};
  background-color: {{ section.settings.discount_back_color | default: '#FF0000' }};
  font-weight: bold;
  margin-bottom: 10px;
  margin: 10px 0 0;
  border-radius: 48px;
  padding: {{ section.settings.discount_padding | default: '8px' }}px;
  width: {{ section.settings.discount_width | default: '70%' }}%;
}

.x9-option-installments,
.x9-option-installments-note {
  font-size: {{ section.settings.installments_font_size }}px;
  color: {{ section.settings.installments_color | default: '#666' }};
  line-height: 1.2;
 
}
.x9-option-installments{
  margin: 15px;
  margin-bottom: 0px;
}

.x9-option-installments-note {
  font-style: italic; 
  margin-bottom: 15px!important;
}

/* Blocos de Conteúdo Customizáveis (Topo e Inferior) */
.x9-option-block {
  margin-bottom: 10px;
}
.x9-option-block-bottom {
    margin-top: 0px;
  margin-bottom: 15px; /* Adiciona margem antes do botão */
}
.x9-option-block p {
  margin: 0;
  font-size: 14px; /* Ajuste para o texto interno */
  color: #777;
}

.x9-buy-button {
  display: block;
  width: 100%;
  /* Correção do preenchimento com !important para garantir funcionalidade */
  padding: {{ section.settings.button_padding_top_bottom }}px {{ section.settings.button_padding_left_right }}px !important;
  background-color: {{ section.settings.button_bg_color | default: '#007bff' }};
  color: {{ section.settings.button_text_color | default: '#fff' }} !important;
  text-align: center;
  text-decoration: none;
  border-radius: {{ section.settings.button_border_radius }}px;
  font-size: {{ section.settings.button_font_size }};
  font-weight: {{ section.settings.button_font_weight }};
  transition: background-color 0.3s ease;
  margin-top: auto; /* Empurra o botão para a parte inferior do card */
}

.x9-buy-button:hover {
  background-color: {{ section.settings.button_hover_bg_color | default: '#0056b3' }};
}

/* Responsividade */
@media (max-width: 768px) {
  .x9-tabs-area-{{ section.id }} {
    padding-left: 10px;
    padding-right: 10px;
  }
  .x9-tab-button {
    font-size: {{ section.settings.tab_font_size_mobile }}px;
    padding: 8px 12px;
  }
  .x9-product-options-grid {
    grid-template-columns: 1fr; /* Uma coluna em mobile */
    padding: 0;
  }
  .x9-option-image {
    /* Customização de largura em % e altura máxima para mobile */
    width: {{ section.settings.option_image_width_mobile }}%;
    max-height: {{ section.settings.option_image_height_mobile }}px;
    height: auto; /* Permite que max-height funcione corretamente */
  }
  .x9-option-title {
    font-size: {{ section.settings.card_title_font_size_mobile }}px;
  }
  .x9-option-old-price {
    font-size: {{ section.settings.old_price_font_size_mobile }}px;
  }
  .x9-option-price {
    font-size: {{ section.settings.price_font_size_mobile }}px;
  }
  .x9-option-discount {
    font-size: {{ section.settings.discount_font_size_mobile }}px;
  }
  .x9-option-installments,
  .x9-option-installments-note {
    font-size: {{ section.settings.installments_font_size_mobile }}px;
  }
  .x9-buy-button {
    font-size: {{ section.settings.button_font_size_mobile }}px;
    padding: 10px 15px !important; /* Mobile padding também com !important */
  }

  /* Specific styles for each label type and instance (for mobile adjustments) */
  {% for block in section.blocks %}
    {% for i in (1..3) %}
      {%- liquid
        assign label_top_fs_mob_key = "option_label_top_" | append: i | append: "_font_size_mobile"
        assign label_bottom_fs_mob_key = "option_label_bottom_" | append: i | append: "_font_size_mobile"
        assign label_top_text_key = "option_label_top_" | append: i | append: "_text"
        assign label_bottom_text_key = "option_label_bottom_" | append: i | append: "_text"

        assign label_top_fs_mob = block.settings[label_top_fs_mob_key]
        assign label_bottom_fs_mob = block.settings[label_bottom_fs_mob_key]
        assign label_top_text = block.settings[label_top_text_key]
        assign label_bottom_text = block.settings[label_bottom_text_key]
      -%}
      {% if label_top_text != blank %}
      .x9-option-label-top-{{ section.id }}-{{ block.id }}-{{ i }} {
        font-size: {{ label_top_fs_mob }}px !important; /* Use !important for mobile override */
        width: 100%;
        margin-bottom:10px!important;
      }
      {% endif %}
      {% if label_bottom_text != blank %}
      .x9-option-label-bottom-{{ section.id }}-{{ block.id }}-{{ i }} {
        font-size: {{ label_bottom_fs_mob }}px !important;
        width: 100%;
      }
      {% endif %}
    {% endfor %}
  {% endfor %}
}
/* ========== [FIM] CSS da Seção Shopify: Abas de Produtos/Sabores ========== */
{%- endstyle -%}

<div class="x9-shopify-tabs-section-{{ section.id }}">
  <div class="x9-tabs-area-{{ section.id }}">

    <div id="kit-precos" class="x9-tabs-header">
      {% for block in section.blocks %}
        {%- liquid
          assign tab_name = block.settings.tab_name
          assign tab_id = block.id
        -%}
        <button class="x9-tab-button{% if forloop.first %} active{% endif %}" data-tab="{{ tab_id }}">{{ tab_name }}</button>
      {% endfor %}
    </div>

    <div class="x9-tabs-content">
      {% for block in section.blocks %}
        {%- liquid
          assign tab_id = block.id
        -%}
        <div id="tab-{{ tab_id }}" class="x9-tab-pane{% if forloop.first %} show{% endif %}" data-tab-content="{{ tab_id }}">
          <div class="x9-product-options-grid">
            {% for i in (1..3) %}
              {%- liquid
                assign image_key = "image_" | append: i
                assign image = block.settings[image_key]

                assign option_title_key = "option_title_" | append: i
                assign option_title = block.settings[option_title_key]

                assign preco_antigo_key = "option_preco_antigo_" | append: i
                assign preco_antigo = block.settings[preco_antigo_key]

                assign price_key = "option_price_" | append: i
                assign price = block.settings[price_key]

                assign discount_key = "option_discount_" | append: i
                assign discount = block.settings[discount_key]

                assign parcelas_key = "option_parcelas_" | append: i
                assign parcelas = block.settings[parcelas_key]

                assign installments_note_key = "option_installments_note_" | append: i
                assign installments_note = block.settings[installments_note_key]

                assign bloco_superior_key = "option_bloco_superior_" | append: i
                assign bloco_superior = block.settings[bloco_superior_key]

                assign bloco_inferior_key = "option_bloco_inferior_" | append: i
                assign bloco_inferior = block.settings[bloco_inferior_key]

                assign btn_link_key = "btn_link_" | append: i
                assign btn_link = block.settings[btn_link_key]

                assign btn_text_key = "btn_text_" | append: i
                assign btn_text = block.settings[btn_text_key]

                
                assign label_top_text_key = "option_label_top_" | append: i | append: "_text"
                assign label_top_fs_desk_key = "option_label_top_" | append: i | append: "_font_size_desktop"
                assign label_top_fs_mob_key = "option_label_top_" | append: i | append: "_font_size_mobile"
                assign label_top_color_key = "option_label_top_" | append: i | append: "_color"
                assign label_top_fw_key = "option_label_top_" | append: i | append: "_font_weight"
                assign label_top_ls_key = "option_label_top_" | append: i | append: "_letter_spacing"
                assign label_top_lh_key = "option_label_top_" | append: i | append: "_line_height"
                assign label_top_bg_color_key = "option_label_top_" | append: i | append: "_bg_color"
                assign label_top_br_key = "option_label_top_" | append: i | append: "_border_radius"
                assign label_top_padding_key = "option_label_top_" | append: i | append: "_padding"

                assign label_top_text = block.settings[label_top_text_key]
                assign label_top_fs_desk = block.settings[label_top_fs_desk_key]
                assign label_top_fs_mob = block.settings[label_top_fs_mob_key]
                assign label_top_color = block.settings[label_top_color_key]
                assign label_top_fw = block.settings[label_top_fw_key]
                assign label_top_ls = block.settings[label_top_ls_key]
                assign label_top_lh = block.settings[label_top_lh_key]
                assign label_top_bg_color = block.settings[label_top_bg_color_key]
                assign label_top_br = block.settings[label_top_br_key]
                assign label_top_padding = block.settings[label_top_padding_key]

                assign label_bottom_text_key = "option_label_bottom_" | append: i | append: "_text"
                assign label_bottom_fs_desk_key = "option_label_bottom_" | append: i | append: "_font_size_desktop"
                assign label_bottom_fs_mob_key = "option_label_bottom_" | append: i | append: "_font_size_mobile"
                assign label_bottom_color_key = "option_label_bottom_" | append: i | append: "_color"
                assign label_bottom_fw_key = "option_label_bottom_" | append: i | append: "_font_weight"
                assign label_bottom_ls_key = "option_label_bottom_" | append: i | append: "_letter_spacing"
                assign label_bottom_lh_key = "option_label_bottom_" | append: i | append: "_line_height"
                assign label_bottom_bg_color_key = "option_label_bottom_" | append: i | append: "_bg_color"
                assign label_bottom_br_key = "option_label_bottom_" | append: i | append: "_border_radius"
                assign label_bottom_padding_key = "option_label_bottom_" | append: i | append: "_padding"

                assign label_bottom_text = block.settings[label_bottom_text_key]
                assign label_bottom_fs_desk = block.settings[label_bottom_fs_desk_key]
                assign label_bottom_fs_mob = block.settings[label_bottom_fs_mob_key]
                assign label_bottom_color = block.settings[label_bottom_color_key]
                assign label_bottom_fw = block.settings[label_bottom_fw_key]
                assign label_bottom_ls = block.settings[label_bottom_ls_key]
                assign label_bottom_lh = block.settings[label_bottom_lh_key]
                assign label_bottom_bg_color = block.settings[label_bottom_bg_color_key]
                assign label_bottom_br = block.settings[label_bottom_br_key]
                assign label_bottom_padding = block.settings[label_bottom_padding_key]
              -%}

              {% if option_title != blank or image != blank or label_top_text != blank or label_bottom_text != blank %}
                <div class="x9-product-option-card">
                  {% if bloco_superior != blank %}
                    <div class="x9-option-block x9-option-block-top">
                      {{ bloco_superior }}
                    </div>
                  {% endif %}

                  {% if label_top_text != blank %}
                    <div class="x9-option-label x9-option-label-top-{{ section.id }}-{{ block.id }}-{{ i }}"
                         style="
                            {% if label_top_bg_color != 'transparent' %}background-color: {{ label_top_bg_color }};{% endif %}
                            {% if label_top_br != blank %}border-radius: {{ label_top_br }}px;{% endif %}
                            {% if label_top_padding != blank %}padding: {{ label_top_padding }};{% endif %}
                            color: {{ label_top_color }};
                            font-size: {{ label_top_fs_desk }}px;
                            font-weight: {{ label_top_fw }};
                            letter-spacing: {{ label_top_ls }}px;
                            line-height: {{ label_top_lh }};
                            text-align: center; /* Ensure text is centered within its own label div */
                            width: 100%;
                            margin-bottom: 5px; /* Small margin between labels */
                         ">
                      {{ label_top_text }}
                    </div>
                  {% endif %}

                  {% if label_bottom_text != blank %}
                    <div class="x9-option-label x9-option-label-bottom-{{ section.id }}-{{ block.id }}-{{ i }}"
                         style="
                            {% if label_bottom_bg_color != 'transparent' %}background-color: {{ label_bottom_bg_color }};{% endif %}
                            {% if label_bottom_br != blank %}border-radius: {{ label_bottom_br }}px;{% endif %}
                            {% if label_bottom_padding != blank %}padding: {{ label_bottom_padding }};{% endif %}
                            color: {{ label_bottom_color }};
                            font-size: {{ label_bottom_fs_desk }}px;
                            font-weight: {{ label_bottom_fw }};
                            letter-spacing: {{ label_bottom_ls }}px;
                            line-height: {{ label_bottom_lh }};
                            text-align: center;
                            width: 100%;
                            margin-bottom: 5px; /* Small margin between labels and image */
                         ">
                      {{ label_bottom_text }}
                    </div>
                  {% endif %}

                  {% if option_title != blank %}
                    <h3 class="x9-option-title">{{ option_title }}</h3>
                  {% endif %}

                  {% if image != blank %}
                    <div class="x9-option-image">
                      <img src="{{ image | image_url: width: 300 }}" alt="{{ image.alt | default: option_title }}" loading="lazy">
                    </div>
                  {% endif %}

                  {% if preco_antigo != blank %}
                    <p class="x9-option-old-price">{{ preco_antigo }}</p>
                  {% endif %}
                  {% if price != blank %}
                    <p class="x9-option-price">{{ price }}</p>
                  {% endif %}

                  {% if discount != blank %}
                    <p class="x9-option-discount">{{ discount }}</p>
                  {% endif %}

                  {% if parcelas != blank %}
                    <p class="x9-option-installments">{{ parcelas }}</p>
                  {% endif %}
                  {% if installments_note != blank %}
                    <p class="x9-option-installments-note">{{ installments_note }}</p>
                  {% endif %}

                  {% if bloco_inferior != blank %}
                    <div class="x9-option-block x9-option-block-bottom">
                      {{ bloco_inferior }}
                    </div>
                  {% endif %}

                  {% if btn_link != blank and btn_text != blank %}
                    <a href="{{ btn_link }}" class="x9-buy-button" data-kit-value="{{ option_title | handleize }}">
                      {{ btn_text }}
                    </a>
                  {% endif %}
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      {% endfor %}
    </div>

  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const section = document.querySelector('.x9-shopify-tabs-section-{{ section.id }}');
    if (section) {
      const tabButtons = section.querySelectorAll('.x9-tabs-header .x9-tab-button');
      const tabPanes = section.querySelectorAll('.x9-tabs-content .x9-tab-pane');

      tabButtons.forEach(button => {
        button.addEventListener('click', function() {
          // Remove 'active' from all buttons
          tabButtons.forEach(btn => btn.classList.remove('active'));
          // Remove 'show' from all panes
          tabPanes.forEach(pane => pane.classList.remove('show'));

          // Add 'active' to clicked button
          this.classList.add('active');

          // Show corresponding tab pane
          const targetTabId = this.dataset.tab;
          const targetPane = section.querySelector(`#tab-${targetTabId}`); // Use section.querySelector for specific targeting
          if (targetPane) {
            targetPane.classList.add('show');
          }
        });
      });

      // Ensure the first tab is active and shown on initial load, if any tabs exist
      if (tabButtons.length > 0 && tabPanes.length > 0) {
        tabButtons[0].classList.add('active');
        tabPanes[0].classList.add('show');
      }
    }
  });
</script>

{% schema %}
{
  "name": "Quitosana Abas Preco/Kits",
  "tag": "section",
  "class": "shopify-section-tabs-kits",
  "settings": [
    {
      "type": "header",
      "content": "Configurações Gerais da Seção"
    },
    {
      "type": "color",
      "id": "section_bg_color",
      "label": "Cor de Fundo da Seção",
      "default": "#fafbfc"
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "label": "Espaçamento Interno Superior (Seção)",
      "min": 0, "max": 100, "step": 1, "unit": "px", "default": 32
