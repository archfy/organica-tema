  irParaLeveTambem(index) {
    this.leveTambemIndex = index;
    const track = document.getElementById('vz-leve-track');
    if (track) {
      track.style.transform = `translateX(-${index * 100}%)`;
    }
    
    const counter = document.getElementById('vz-leve-current');
    if (counter) {
      counter.textContent = index + 1;
    }
  },

  anteriorLeveTambem() {
    const anterior = (this.leveTambemIndex - 1 + this.leveTambemProdutos.length) % this.leveTambemProdutos.length;
    this.irParaLeveTambem(anterior);
  },

  proximoLeveTambem() {
    const proximo = (this.leveTambemIndex + 1) % this.leveTambemProdutos.length;
    this.irParaLeveTambem(proximo);
  },

