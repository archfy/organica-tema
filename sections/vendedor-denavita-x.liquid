  /* === CUPOM DE DESCONTO === */
.vz-cupom-container {
  margin-bottom: 0px;
  padding-top:0px;
  display: none;
}
.vz-cupom-form {
  display: flex;
  gap: 10px;
}
.vz-cupom-input {
  background: #fff;
  border: 1px solid #ccc !important;
  color: #333;
  display: block;
  flex: 1;
  line-height: 2.5em;
  max-height: 38px;
  max-width: 70%;
  min-height: 10px;
  outline: none !important;
  padding: 0 10px !important;
  pointer-events: all;
  text-indent: 0 !important;
  width: auto;
  position: relative;
}
.vz-cupom-btn {
  padding: 0px 16px;
  background:#000;
  color: white;
  border: none;
  border-radius: 25px;
  cursor: pointer;
  font-weight: bold;
  font-size: 14px;
  max-height: 38px;
  position: relative;
  min-width: 95px;
  margin-left: auto;
  margin-right: auto;
}
.vz-cupom-btn:hover {
  /*opacity: 0.9;*/
}
.vz-cupom-msg {
  font-size: 12px;
  margin-top: 5px;
}
.vz-cupom-msg.success {
  color: var(--vz-cor-sucesso);
  padding: .7rem 2rem .7rem 4.5rem;
  margin-bottom: 1.5rem;
}
.vz-cupom-msg.error {
  color: #e74c3c;
}
/* === CUPOM APLICADO (layout igual imagem) === */
.vz-cupom-aplicado {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10px 6px;
  background: #f5f5f5;
  border-radius: 8px;
  margin-bottom: 10px;
  font-size: 12px;
  border: 1px solid #e0e0e0;
  max-height: 39px;
}
.vz-cupom-tag {
  display: flex;
  align-items: center;
  background: white;
  padding: 6px 8px;
  border-radius: 20px;
  font-weight: 600;
  border: 1px solid #ddd;
}
.vz-cupom-tag::before {
  content: '🎟️';
  font-size: 14px;
}
.vz-cupom-remove {
  background: transparent;
  border: none;
  color: #999;
  cursor: pointer;
  font-size: 18px;
  padding: 0 5px;
  line-height: 1;
}
.vz-cupom-remove:hover {
  color: #333;
}

/* === TOTAIS COM DESCONTO === */
.vz-carrinho-subtotal,
.vz-carrinho-desconto,
.vz-carrinho-frete {
  display: flex;
  justify-content: space-between;
  font-size: 13px;
  color: #666;
}
.vz-carrinho-desconto {
  color: #00c851;
  font-weight: 600;
}
.vz-carrinho-total {
  display: flex;
  justify-content: space-between;
  font-size: 16px;
  font-weight: bold;
  margin-top: 0px;
  padding-top: 5px;
  border-top: 1px solid #eee;
  color: #000;
  margin-bottom: 0px!important;
}

.vz-carrinho-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100000;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.3s ease, visibility 0.3s ease;
  pointer-events: none;
}

.vz-carrinho-overlay.ativo {
  opacity: 1;
  visibility: visible;
  pointer-events: all;
}

/* Mobile: Overlay mais visível nos 6% */
@media (max-width: 768px) {
  .vz-carrinho-overlay.ativo {
    background: rgba(0, 0, 0, 0.7);
