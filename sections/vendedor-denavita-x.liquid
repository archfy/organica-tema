}

.vz-carrinho-item.updating::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 40px;
  height: 40px;
  border: 3px solid rgba(84, 177, 1, 0.2);
  border-top-color: #54B101;
  border-radius: 50%;
  animation: vz-spin 0.8s linear infinite;
}

@keyframes vz-spin {
  to { transform: translate(-50%, -50%) rotate(360deg); }
}

