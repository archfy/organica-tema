  }
})();

document.addEventListener('DOMContentLoaded', function() {
  // Busca o ícone do carrinho
  const cartIcon = document.getElementById('cart-icon-bubble');
  
  if (cartIcon) {
    // Remove o href para não navegar
    cartIcon.removeAttribute('href');
    
    // Adiciona cursor pointer
    cartIcon.style.cursor = 'pointer';
    
    // Intercepta o clique
    cartIcon.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      
      // Abre o carrinho VZ
      if (typeof VZ !== 'undefined' && typeof VZ.abrirCarrinho === 'function') {
        VZ.abrirCarrinho();
      } else {
        console.error('VZ.abrirCarrinho não encontrado');
      }
    });
    
    console.log('✅ Ícone do carrinho interceptado');
  }
});  
