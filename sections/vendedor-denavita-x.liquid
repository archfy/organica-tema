  async carregarLeveTambem() {
    const collectionHandle = '{{ section.settings.colecao_leve_tambem.handle }}';
    if (!collectionHandle) return;

    try {
      const response = await fetch(`/collections/${collectionHandle}/products.json?limit=5`);
      const data = await response.json();
      this.leveTambemProdutos = data.products || [];
      
      if (this.leveTambemProdutos.length > 0) {
        this.renderLeveTambem();
        document.getElementById('vz-leve-tambem').style.display = 'block';
      }
    } catch (e) {
      if (this.config.debug) console.error('Erro ao carregar Leve Também:', e);
    }
  },

  renderLeveTambem() {
    const track = document.getElementById('vz-leve-track');
    const nav = document.getElementById('vz-leve-nav');
    
    if (!track || !nav) return;

    track.innerHTML = '';
    nav.innerHTML = '';

    this.leveTambemProdutos.forEach((produto, index) => {
      const item = document.createElement('div');
      item.className = 'vz-leve-item';
      
      const variant = produto.variants[0];
      
      let imagem = 'https://via.placeholder.com/90';
      if (produto.images && produto.images.length > 0) {
        const img = produto.images[0];
        imagem = typeof img === 'string' ? img : (img.src || img);
      } else if (produto.featured_image) {
        imagem = produto.featured_image;
      }
      
      const precoReais = variant.price;
      const preco = precoReais.toLocaleString('pt-BR', { 
        minimumFractionDigits: 2, 
        maximumFractionDigits: 2 
      });
      
      item.innerHTML = `
        <img src="${imagem}" alt="${produto.title}">
        <div class="vz-leve-info">
          <h5>${produto.title}</h5>
          <p>R$ ${preco}</p>
        </div>
        <button 
          class="vz-leve-add-btn" 
          onclick="VZ.adicionarLeveTambem(${variant.id})"
          aria-label="Adicionar ${produto.title}"
        >
          Adicionar
        </button>
      `;
      track.appendChild(item);
    });

    if (this.leveTambemProdutos.length > 1) {
      nav.innerHTML = `
        <button 
          class="vz-leve-arrow" 
          onclick="VZ.anteriorLeveTambem()"
          aria-label="Produto anterior"
        >
          <svg viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M11.764 5.204a.75.75 0 0 1 .032 1.06l-3.516 3.736 3.516 3.736a.75.75 0 1 1-1.092 1.028l-4-4.25a.75.75 0 0 1 0-1.028l4-4.25a.75.75 0 0 1 1.06-.032Z"></path>
          </svg>
        </button>
        <span class="vz-leve-counter">
          <span id="vz-leve-current">1</span> / ${this.leveTambemProdutos.length}
        </span>
        <button 
          class="vz-leve-arrow" 
          onclick="VZ.proximoLeveTambem()"
          aria-label="Próximo produto"
        >
          <svg viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M7.72 14.53a.75.75 0 0 1 0-1.06l3.47-3.47-3.47-3.47a.75.75 0 0 1 1.06-1.06l4 4a.75.75 0 0 1 0 1.06l-4 4a.75.75 0 0 1-1.06 0Z"></path>
          </svg>
        </button>
      `;

      setInterval(() => {
        this.proximoLeveTambem();
      }, 5000);
    }
