<script>
const VZ = {
  config: {
    enabled: {{ section.settings.enabled | json }},
    delay: {{ section.settings.delay_segundos }}000,
    personality: {{ section.settings.personalidade | json }},
    modo_gaveta: {{ section.settings.modo_gaveta | json }},
    frete_gratis: {{ section.settings.valor_frete_gratis }},
    brinde1_valor: {{ section.settings.valor_brinde_1 }},
    brinde2_valor: {{ section.settings.valor_brinde_2 }},
    brinde3_valor: {{ section.settings.valor_brinde_3 }},
    brinde1_id: '{{ section.settings.produto_brinde_1.selected_or_first_available_variant.id }}',
    brinde2_id: '{{ section.settings.produto_brinde_2.selected_or_first_available_variant.id }}',
    brinde3_id: '{{ section.settings.produto_brinde_3.selected_or_first_available_variant.id }}',
    debug: {{ section.settings.debug_mode | json }},
    quickbuy_gaveta: {{ section.settings.quickbuy_gaveta_enabled | json }},
    confetti: {{ section.settings.mostrar_confetti | json }},
    high_contrast: {{ section.settings.high_contrast_mode | json }}
  },
   carrinhoCache: {
    itemCount: 0,
    totalPrice: 0,
    items: []
  },
  // Debounce helper
  debounceTimers: {},
  debounce(func, delay, id = 'default') {
    return (...args) => {
      clearTimeout(this.debounceTimers[id]);
      this.debounceTimers[id] = setTimeout(() => func.apply(this, args), delay);
    };
  },  

  brindeCarrosselInterval: null,
  ultimosBrindesKeys: '',
  ultimoItemCount: 0,
  estado_atual: 'observando',
  tentativas_fechar: 0,
  modo_chat: false,
  carrinho_valor: 0,
  monitorCarrinhoInterval: null,
  isMonitoring: false,
  brindes_no_carrinho: {
    brinde1: false,
    brinde2: false,
    brinde3: false
  },
  cart_items: [],
  sugestoesProdutos: [],
  darkMode: false,
  brindeLock: false,
  eventListenersAttached: false,
  swipeHandlerAttached: false,
  
  /*
  mensagens: {
    inicial: {{ section.settings.mensagens_iniciais | split: '|' | json }},
    fechar: {{ section.settings.mensagens_fechar | split: '|' | json }},
    chat: ['Como posso ajudar?', 'Alguma dúvida?', 'Tô aqui pra ajudar!']
  },
  */

  leveTambemProdutos: [],
  leveTambemIndex: 0,
  cupomAtual: null,
  descontoPercentual: 0,
  descontoValor: 0,

  async carregarSugestoesCarrinho() {
    const collectionHandle = '{{ section.settings.colecao_produtos.handle }}';
    if (!collectionHandle) {
      if (this.config.debug) console.log('⚠️ Nenhuma coleção configurada para sugestões');
      return;
    }

    try {
      const response = await fetch(`/collections/${collectionHandle}/products.json?limit=3`);
      const data = await response.json();
      this.sugestoesProdutos = data.products || [];
      
      if (this.config.debug) console.log('✅ Sugestões carregadas:', this.sugestoesProdutos.length, 'produtos');
    } catch (e) {
      if (this.config.debug) console.error('❌ Erro ao carregar sugestões:', e);
    }
  },

  renderSugestoesCarrinhoVazio() {
    const container = document.getElementById('vz-cart-items');
    if (!container) {
      if (this.config.debug) console.error('❌ Container não encontrado!');
      return;
    }
    
    if (!this.sugestoesProdutos || this.sugestoesProdutos.length === 0) {
      container.innerHTML = `
        <div style="text-align:center;padding:40px;">
          <p style="font-size:18px;margin-bottom:20px;">🛒 Carrinho vazio</p>
          <p style="color:#666;font-size:14px;">Adicione produtos para começar!</p>
        </div>
      `;
      return;
    }
    
    let html = '<div class="vz-carrinho-sugestoes">';
    html += '<div class="vz-carrinho-sugestoes-titulo">✨ Comece seu pedido. Escolha e adicione ao carrinho</div>';
    
    this.sugestoesProdutos.forEach((produto, produtoIndex) => {
      const variantsToShow = produto.variants.slice(0, 3);
      
      html += '<div class="vz-sugestao-item">';
      
      html += `
        <div class="vz-qb-details" style="margin-bottom: 10px;">
          <h4 class="vz-qb-details-h4" style="margin: 0 0 2px 0;">${produto.title}</h4>
          <p class="vz-qb-details-p" style="color: #B7BBC1; margin: 0;">Escolha sua opção:</p>
        </div>
      `;
      
      html += '<div class="vz-sugestao-variantes">';
      
      variantsToShow.forEach((variant, index) => {
        let variantImage = '';
        
        if (variant.featured_image) {
          const featImg = variant.featured_image;
          variantImage = typeof featImg === 'object' ? (featImg.src || featImg.url || '') : featImg;
        } 
        
        if (!variantImage && produto.images && produto.images[variant.position - 1]) {
          const posImg = produto.images[variant.position - 1];
          variantImage = typeof posImg === 'object' ? (posImg.src || posImg.url || '') : posImg;
        }
        
        if (!variantImage) {
          let imagemProduto = produto.featured_image;
          if (typeof imagemProduto === 'object' && imagemProduto !== null) {
            imagemProduto = imagemProduto.src || imagemProduto.url || '';
          }
          variantImage = imagemProduto;
        }
        
        variantImage = String(variantImage || '');
        
        if (variantImage && !variantImage.startsWith('http')) {
          variantImage = 'https:' + variantImage;
        }
        
        if (!variantImage) {
          variantImage = 'https://via.placeholder.com/100';
        }
        
        const variantTitle = variant.title === 'Default Title' ? 'Mix de Sabores' : variant.title;
        const disponivel = variant.available;
        
        const precoVariante = variant.price;
        const parcela3x = (precoVariante / 3).toLocaleString('pt-BR', {
          minimumFractionDigits: 2,
          maximumFractionDigits: 2
        });
        const precoVista = precoVariante.toLocaleString('pt-BR', {
          minimumFractionDigits: 2,
          maximumFractionDigits: 2
        });
        
        let badgesHTML = '';
        
        if (index === 1) {
          badgesHTML += '<span class="vz-sugestao-badge-verde">Mais Vendido</span>';
        }
        
        if (index === 2) {
          badgesHTML += '<span class="vz-sugestao-badge-verde">Menor Preço</span>';
        }
        
        if (precoVariante >= this.config.frete_gratis) {
          badgesHTML += '<span class="vz-sugestao-badge-laranja">Frete Grátis</span>';
        }
        
        html += `
          <button 
            class="vz-sugestao-variant-btn" 
            onclick="VZ.adicionarVarianteSugestao(${variant.id}, event)"
            ${!disponivel ? 'disabled' : ''}
          >
            <div class="vz-sugestao-variant-image-principal">
              <img 
                src="${variantImage}"
                alt="${variantTitle}"
                onerror="this.src='https://via.placeholder.com/100'"
