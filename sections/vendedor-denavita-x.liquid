  setupBalaoContrast() {
    const balaoTexto = document.getElementById('vz-balao-texto');
    if (!balaoTexto) return;
    window.addEventListener('scroll', () => {
      const rect = balaoTexto.getBoundingClientRect();
      const x = rect.left + rect.width / 2;
      const y = rect.top + rect.height / 2;
      const elementUnder = document.elementFromPoint(x, y);
      if (elementUnder) {
        const bgColor = window.getComputedStyle(elementUnder).backgroundColor;
        const rgb = bgColor.match(/\d+/g);
        if (rgb) {
          const brightness = (parseInt(rgb[0]) * 299 + parseInt(rgb[1]) * 587 + parseInt(rgb[2]) * 114) / 1000;
          balaoTexto.style.color = brightness > 128 ? '#000' : '#fff';
        }
      }
    });
  },

  setupSwipe() {
    if (this.swipeHandlerAttached) return;
    
    const carrossel = document.getElementById('vz-carrossel');
    if (!carrossel) return;
    
    let startX;
    
    const handleTouchStart = (e) => {
      startX = e.touches[0].clientX;
    };
    
    const handleTouchMove = (e) => {
      const diffX = startX - e.touches[0].clientX;
      carrossel.scrollLeft += diffX;
      startX = e.touches[0].clientX;
    };
    
    carrossel.addEventListener('touchstart', handleTouchStart, {passive: true});
    carrossel.addEventListener('touchmove', handleTouchMove, {passive: true});
    
    this.swipeHandlerAttached = true;
    
    this.swipeHandlers = {
      touchstart: handleTouchStart,
      touchmove: handleTouchMove,
      element: carrossel
    };
  },

  cleanupSwipe() {
    if (this.swipeHandlers && this.swipeHandlers.element) {
      this.swipeHandlers.element.removeEventListener('touchstart', this.swipeHandlers.touchstart);
      this.swipeHandlers.element.removeEventListener('touchmove', this.swipeHandlers.touchmove);
      this.swipeHandlers = null;
      this.swipeHandlerAttached = false;
    }
  },

  toggleDarkMode() {
    this.darkMode = !this.darkMode;
    document.body.classList.toggle('dark-mode', this.darkMode);
