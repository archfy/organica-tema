  .vz-gaveta {
    position: fixed;
    bottom: -100%;
    left: 10%;
    right: 10%;
    width: 80%;
    height: 60vh;
    background: linear-gradient(135deg, var(--vz-cor-primaria), var(--vz-cor-secundaria));
    border-radius: 20px;
    transition: bottom 0.5s ease;
    z-index: 100000;
    display: flex;
    flex-direction: column;
  }
  .vz-gaveta.aberto {
    bottom: 0;
  }
  .vz-gaveta-header {
    color: white;
    padding: var(--vz-spacing);
    text-align: center;
    font-size: 18px;
    font-weight: bold;
    position: relative;
    border-radius: 20px 20px 0 0;
    background: #153201;
    padding: 15px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .vz-gaveta-header h3 {
    margin: 0;
    color: white;
    font-size: 18px;
    padding-bottom: 3px
  }
  #dark-toggle {
    background: transparent;
    border: none;
    color: white;
    cursor: pointer;
  }
  .vz-gaveta-close {
    position: absolute;
    top: 15px;
    right: 15px;
    background: rgba(255,255,255,0.2);
    color: white;
    border: 2px solid white;
    border-radius: 50%;
    width: 30px;
    height: 30px;
    font-size: 20px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s;
  }
  .vz-gaveta-close:hover {
    background: white;
    color: var(--vz-cor-primaria);
    transform: scale(1.1);
  }
  .vz-dots-loader {
    display: inline;
    font-size: 18px;
    font-weight: bold;
    color: var(--vz-cor-sucesso);
    margin-left: 5px;
    animation: dots 1.5s infinite;
    height:26px;
  }
  .vz-dots-loader.active {
    display: none;
  }
  @keyframes dots {
    0%, 20% { transform: translateY(0); }
    10% { transform: translateY(-10px); }
    30% { transform: translateY(0); }
    100% { transform: translateY(0); }
  }
  .vz-gaveta-body {
    flex: 1;
    padding: var(--vz-spacing);
    overflow-y: auto;
    background: white;
    position: relative;
    padding-bottom: 10px;
  }
  .vz-progress-container {
    font-size: 12px;
    border-radius: 8px;
    background: #ebffd9;
    border: 1px solid #BDC0B9;
    padding: 0 13px 35px;
    margin: 5px auto 0;
    min-width: 95%;
  padding-left: 10px;
  padding-right: 30px;
  min-height: 12%;
  }
  .vz-progress {
    background: #c5c5c5;
    height: 8px;
    border-radius: 20px;
    position: relative;
    margin: 10px;
    display: flex;
    justify-content: space-between;
  }
  .vz-progress-fill {
    height: 100%;
    border-radius: 20px;
    transition: all 4s;
  animation: 5s linear infinite progress;
  background-color: #54b101;
  -webkit-background-image: linear-gradient(135deg,rgba(255,255,255,.15) 0,rgba(255,255,255,.15) 25%,rgba(255,255,255,0) 25%,rgba(255,255,255,0) 50%,rgba(255,255,255,.15) 50%,rgba(255,255,255,.15) 75%,rgba(255,255,255,0) 75%,rgba(255,255,255,0) 100%);
  -moz-background-image: linear-gradient(135deg,rgba(255,255,255,.15) 0,rgba(255,255,255,.15) 25%,rgba(255,255,255,0) 25%,rgba(255,255,255,0) 50%,rgba(255,255,255,.15) 50%,rgba(255,255,255,.15) 75%,rgba(255,255,255,0) 75%,rgba(255,255,255,0) 100%);
  -ms-background-image: linear-gradient(135deg,rgba(255,255,255,.15) 0,rgba(255,255,255,.15) 25%,rgba(255,255,255,0) 25%,rgba(255,255,255,0) 50%,rgba(255,255,255,.15) 50%,rgba(255,255,255,.15) 75%,rgba(255,255,255,0) 75%,rgba(255,255,255,0) 100%);
  background-image: linear-gradient(135deg,#ffffff26 0 25%,#fff0 25% 50%,#ffffff26 50% 75%,#fff0 75% 100%);
  background-size: 40px 40px;
    
  }
  .vz-progress-msg {
    font-size:11px;
    font-weight: bold;
    color: var(--vz-cor-texto);
    text-align: center;
  padding: 0 20px;
  padding-left: 40px;
  margin-top: 10px;
  padding-bottom: 20px;
  }
  .vz-milestone {
    text-align: center;
    font-size: 12px;
    /*opacity: 0.5;*/
    transition: all 0.3s;
    flex: 1;
    position: relative;
  }
  .vz-milestone.achieved {
   /* opacity: 1;*/
    transform: scale(1.2);
  }
  .vz-milestone .tooltip {
    display: none;
    position: absolute;
    bottom: 100%;
    left: 50%;
    transform: translateX(-50%);
    background: #fff;
    border: 1px solid #ccc;
    padding: 5px;
    border-radius: 5px;
    white-space: nowrap;
    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
  }
  .vz-milestone:hover .tooltip {
    display: block;
  }
  .vz-produtos-carrossel,
  .vz-recs {
    display: flex;
    gap: 15px;
    overflow-x: auto;
    padding: calc(var(--vz-spacing) * 1.5);
    -webkit-overflow-scrolling: touch;
  }
  .vz-produto,
  .vz-rec-item {
    flex: 0 0 150px;
    background: white;
    border-radius: 10px;
    padding: 10px;
    text-align: center;
    cursor: pointer;
    border: 2px solid #eee;
    transition: all 0.3s;
  }
  .vz-produto:hover,
  .vz-rec-item:hover {
    transform: translateY(-5px);
    border-color: var(--vz-cor-sucesso);
    box-shadow: 0 10px 20px rgba(0,0,0,0.1);
  }
  .vz-produto img,
  .vz-rec-item img {
    height: 120px;
    object-fit: cover;
    border-radius: 5px;
    max-width: 120px;
  }
  .vz-produto h4,
  .vz-rec-item h4 {
    font-size: 14px;
    margin: 10px 0 5px;
  }
  .vz-produto p,
  .vz-rec-item p {
    font-weight: bold;
    color: var(--vz-cor-sucesso);
    margin: 0;
  }
  .vz-trilha-gamificacao {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: calc(var(--vz-spacing) * 1.5);
    position: relative;
    background: linear-gradient(135deg, #f5f5f5, #ffffff);
    border-radius: 15px;
    margin: var(--vz-spacing);
  }
  .vz-trilha-item {
    position: relative;
    z-index: 2;
    text-align: center;
    flex: 1;
    max-width: 120px;
  }
  .vz-trilha-circulo {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: rgba(224,224,224,0.8);
    backdrop-filter: blur(5px);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 30px;
    margin: 0 auto 10px;
    transition: all 0.3s;
    border: 3px solid #ccc;
    position: relative;
  }
  .vz-trilha-item.ativo .vz-trilha-circulo {
    background: linear-gradient(135deg, var(--vz-cor-sucesso), #00ff88);
    border-color: var(--vz-cor-sucesso);
    animation: pulse 2s infinite;
    box-shadow: 0 0 20px rgba(0,255,136,0.5);
  }
  .vz-trilha-item.conquistado .vz-trilha-circulo {
    background: var(--vz-cor-sucesso);
    border-color: #00ff88;
  }
  .vz-trilha-item.conquistado .vz-trilha-check {
    display: block;
  }
  .vz-trilha-check {
    position: absolute;
    top: -10px;
    right: -10px;
    background: #00ff88;
    width: 25px;
    height: 25px;
    border-radius: 50%;
    display: none;
    align-items: center;
    justify-content: center;
    font-size: 14px;
  }
  .vz-trilha-linha {
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    height: 4px;
    background: #e0e0e0;
    z-index: 1;
    transform: translateY(-20px);
  }
  .vz-trilha-linha-progresso {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    background: linear-gradient(90deg, var(--vz-cor-sucesso), #00ff88);
    transition: width 0.5s ease;
    width: 0%;
  }
  .vz-trilha-titulo {
    font-size: 16px;
    font-weight: bold;
    color: #666;
    margin-bottom: 5px;
  }
  .vz-trilha-valor {
    font-size: 14px;
    color: var(--vz-cor-sucesso);
    font-weight: bold;
  }
  .vz-trilha-item.conquistado .vz-trilha-titulo {
    color: var(--vz-cor-sucesso);
  }
  @keyframes pulse {
    0% { transform: scale(1); }
    50% { transform: scale(1.05); }
    100% { transform: scale(1); }
  }
  .vz-chat-btn {
    /*position: relative;
    bottom: var(--vz-spacing);
    right: var(--vz-spacing);*/
    background: var(--vz-cor-sucesso);
    color: white;
    border: none;
    padding: 10px 20px;
    border-radius: 20px;
    cursor: pointer;
    font-weight: bold;
    margin-top: 15px;
    font-size: 11px;
  }
  .vz-carrinho {
    position: fixed;
    right: -430px;
    top: 0;
    width: 400px;
    height: 100vh;
    background: rgba(255,255,255,0.1);
    /*backdrop-filter: blur(10px);*/
    box-shadow: -2px 0 10px rgba(0,0,0,0.1);
    transition: right 0.3s ease;
    z-index: 100001;
    display: flex;
    flex-direction: column;
    background: #ffffff !important;
    -webkit-backdrop-filter: none !important;
    backdrop-filter: none !important;
    opacity: 1 !important;
  }
  .vz-carrinho.aberto {
    right: 0;
  }
  .vz-carrinho-header {
    background: #ec6614;
    color: white;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px;
    max-height: 33px;
    height: auto;
  }
  .vz-brindes-container {
    display: none;
    margin: 8px 0;
    text-align: center;
    position: relative;
    overflow: hidden;
    width: 95%;
    box-sizing: border-box;
    margin-left: 10px;
  }
  
  .vz-brindes-carrossel {
    position: relative;
    display: flex;
    height: 65px;
    width: 100%;
    transition: transform 0.5s ease;
    margin: 0 auto;
  }
  .vz-brinde-slide {
    min-width: 100%;
    width: 100%;
    flex: 0 0 100%;
    border: 1px solid #BDC0B9;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 10px;
    background: rgba(0, 200, 81, 0.1);
    border-radius: 10px;
    box-sizing: border-box;
    line-height: 1.4;
  }
  .vz-brinde-slide img {
    width: 50px;
    height: 50px;
    object-fit: cover;
    border-radius: 5px;
  }
  #vz-quickbuy {
    position: fixed;
    bottom: -100%;
    height: auto;
    background: linear-gradient(135deg, var(--vz-cor-primaria), var(--vz-cor-secundaria));
    border-radius: 20px 20px 0 0;
    transition: bottom 0.3s cubic-bezier(0.68, -0.55, 0.265, 1.55);
    z-index: 100002;
    overflow: hidden;
  }
  #vz-quickbuy.aberto {
    bottom: 0;
  }
  .vz-qb-header {
    background: #153201;
    padding: 15px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .vz-qb-body {
    background: white;
    padding: 20px;
    text-align: center;
  }
  .vz-qb-product-info {
    display: flex;
    gap: 20px;
    align-items: center;
    margin-bottom: 20px;
  }
  .vz-qb-image {
    width: 100px;
    height: 100px;
    object-fit: cover;
    border-radius: 10px;
  }
  .vz-qb-details {
    flex: 1;
    text-align: left;
  }
  .vz-qb-variants {
    display: flex;
    gap: 10px;
    justify-content: center;
    flex-wrap: wrap;
    margin: 20px 0;
  }
  .vz-qb-variant {
    padding: 0 20px;
    background: #fff;
    border-radius: 18px;
    cursor: pointer;
    transition: all 0.3s;
    position: relative;
    color: #000;
    border: 2px solid #DEDEDE;
  }
  .vz-qb-variant:hover {
    
    border: 2px solid #54b101;
    color: #0B6809;
    background:#fff;
  }
  .vz-qb-variant.selecionado {
    
    color: #fff;
    border: 2px solid #54B101;
  }
  .vz-qb-variant.adicionando::after {
    content: '✓';
    position: absolute;
    top: -10px;
    right: -10px;
    background: #54B101;
    width: 25px;
    height: 25px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    animation: scaleIn 0.3s;
  }
  @keyframes scaleIn {
    from { transform: scale(0); }
    to { transform: scale(1); }
  }
  .vz-qb-price {
    font-size: 24px;
    font-weight: bold;
    color: var(--vz-cor-sucesso);
    margin: 10px 0;
    display: none;
  }
  .vz-carrinho-items {
    overflow-y: auto;
    padding: var(--vz-spacing);
    padding-top: 0;
  }
  .vz-carrinho-item {
    display: grid;
    grid-template-columns: 80px 1fr auto;
    gap: 15px;
    padding: 15px 0;
    border-bottom: 1px solid #eee;
    position: relative;
  }
  .vz-carrinho-div-qnt{
    margin-top: 5px;border: 1px solid #dedede;border-radius: 30px;position:relative;width:fit-content;top:-35%;margin-left:auto;margin-right:auto;
  }
  .vz-carrinho-item img {
    width: 90px;
    height: 90px;
    object-fit: cover;
    border-radius: 10px;
    border: 1px solid #f0f0f0;
    padding: 5px;
    transition: opacity .3s;
  }
  @media (max-width: 390px) {
    
  .vz-carrinho-div-qnt{
    zoom: 95%;
    right: -2%;
  }
}

@media (max-width: 390px) {
  .vz-carrinho-header{
  zoom:95%;
  }
  .vz-progress-container{
  zoom:95%;
  }
  .vz-brindes-container{
  zoom:95%;
  }
  .vz-carrinho-items{
  zoom:95%;
  }
  .vz-carrinho-item{
  zoom:95%;
  }
  .vz-carrinho-div-qnt{
  zoom:95%;
  }
  .vz-leve-tambem{
  zoom:95%;
  }
  .vz-leve-carrossel{
  zoom:95%;
  }
  .vz-carrinho-footer{
  zoom:95%;
  }
  .vz-cupom-container{
  zoom:95%;
  }
}

@media only screen and (width: 393px) and (height: 852px) and (-webkit-device-pixel-ratio: 3) { 
.vz-carrinho-items{
zoom:90%;
}
}
  .vz-carrinho-footer {
    height: auto;
    padding: 5px;
    padding-left: 30px;
    padding-right: 30px;
    position: sticky;
    bottom: 0;
    background: #fff;
    width: 100%;
    z-index: 10;
    flex-shrink: 0;
  }
  .vz-carrinho-total {
    display: flex;
    justify-content: space-between;
    font-size: 14px;
    font-weight: bold;
    margin-bottom: 5px;
  }

  .vz-checkout-container {
  display: flex;
  gap: 10px;
  align-items: center;
  background: white;
  position: sticky;
  bottom: 0;
  z-index: 1001;
  padding-bottom: env(safe-area-inset-bottom, 10px);
  min-height: 50px;
}

/* Link "Continuar Comprando" */
