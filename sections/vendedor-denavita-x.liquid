  falar(texto) {
    if (!texto || typeof texto !== 'string') return;
    
    const balao = document.getElementById('vz-balao-texto');
    if (!balao) return;
    
    balao.innerHTML = '';
    let i = 0;
    const digitar = setInterval(() => {
      if (i < texto.length) {
        balao.innerHTML += texto[i];
        i++;
      } else {
        clearInterval(digitar);
      }
    }, 50);
  },

