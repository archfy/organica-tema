    const diff = targetDate - now;
    
    if (diff <= 0) {
      return '00 dia e 00 : 00 : 00';
    }
    
    const days = Math.floor(diff / (1000 * 60 * 60 * 24));
    const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
    const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
    const seconds = Math.floor((diff % (1000 * 60)) / 1000);
    
    return `${days.toString().padStart(2, '0')} dia e ${hours.toString().padStart(2, '0')} : ${minutes.toString().padStart(2, '0')} : ${seconds.toString().padStart(2, '0')}`;
  };
  
  const initialTime = updateCountdown();
  
  if (this.countdownInterval) {
    clearInterval(this.countdownInterval);
  }
  
  this.countdownInterval = setInterval(() => {
    const timerEl = document.getElementById('black-countdown-timer');
    if (timerEl) {
      timerEl.textContent = updateCountdown();
    }
  }, 1000);
  
  return initialTime;
},

