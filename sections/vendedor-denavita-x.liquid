  async addVariantToCart(variant) {
    const btn = event.currentTarget;
    btn.classList.add('selecionado', 'adicionando');
    
    const msgEl = document.getElementById('qb-message');
    
    try {
      // ✅ SIMPLIFICADO: Apenas adiciona, monitor atualiza
      const response = await fetch('/cart/add.js', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({
          id: variant.id,
          quantity: 1
        })
      });
      
      if (!response.ok) throw new Error('Falha ao adicionar');
      
      // ✅ Força checagem imediata (não bloqueia)
      VZ.forcarAtualizacao();
      
      if (msgEl) msgEl.textContent = '✅ Adicionado!';
      
      // ✅ Limpa estado do botão
      btn.classList.remove('selecionado', 'adicionando');
      
      setTimeout(() => {
        this.close();
        VZ.abrirCarrinho();
        if (msgEl) msgEl.textContent = '';
      }, 800);
      
    } catch (e) {
      console.error('Erro:', e);
      btn.classList.remove('selecionado', 'adicionando');
      if (msgEl) msgEl.textContent = '❌ Erro';
      
      // ✅ Limpa erro após 3 segundos
      setTimeout(() => {
        if (msgEl) msgEl.textContent = '';
      }, 3000);
    }
  },
  
  close() {
    if (this.countdownInterval) {
    clearInterval(this.countdownInterval);
    this.countdownInterval = null;
  }
  
  if (this.thirdCountdownInterval) {
    clearInterval(this.thirdCountdownInterval);
    this.thirdCountdownInterval = null;
  }

    const quickbuy = document.getElementById('vz-quickbuy');
    const overlay = document.getElementById('vz-overlay');
    
    if (quickbuy) quickbuy.classList.remove('aberto');
    if (overlay) overlay.style.display = 'none';
    
    setTimeout(() => {
      const mascote = document.getElementById('vz-mascote');
      if (mascote) mascote.style.display = 'block';
      VZ.falar('Produto no carrinho! 🛒');
    }, 500);
  }
};

(function() {
  if (VZ.config.enabled) {
    // Tenta iniciar imediatamente
    if (document.readyState === 'loading') {
      // HTML ainda carregando, espera um pouco
      document.addEventListener('DOMContentLoaded', function() {
