 async monitorarCarrinho() {
    if (this.isMonitoring) return;
    this.isMonitoring = true;
    
    // ✅ Primeira checagem imediata
    await this.checarCarrinho();
    
    this.monitorCarrinhoInterval = setInterval(async () => {
      try {
        const response = await fetch('/cart.js');
        if (!response.ok) throw new Error('Falha na API');
        
        const cart = await response.json();
        this.processarCarrinho(cart);
      } catch (e) {
        if (this.config.debug) console.error('❌ Erro no monitor:', e);
      }
    }, 5000); // ✅ 5 segundos ao invés de 3
  },
  
