    let percent = 0;
    let mensagem = '';
    
    const milestones = [
      { valor: this.config.frete_gratis, nome: 'frete grátis', index: 0 },
      { valor: this.config.brinde1_valor, nome: 'brinde 1', index: 1 },
      { valor: this.config.brinde2_valor, nome: 'brinde 2', index: 2 },
      { valor: this.config.brinde3_valor, nome: 'brinde 3', index: 3 }
    ].filter(m => m.valor && m.valor > 0 && !isNaN(m.valor)).sort((a, b) => a.valor - b.valor);
    
