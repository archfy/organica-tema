  atualizarBrindesCarrossel(brindes) {
    const container = document.getElementById('vz-brindes-container');
    const carrossel = document.getElementById('vz-brindes-carrossel');
    
    if (!container || !carrossel) return;

    if (this.brindeCarrosselInterval) {
      clearInterval(this.brindeCarrosselInterval);
      this.brindeCarrosselInterval = null;
    }

    if (brindes.length === 0) {
      container.style.display = 'none';
      return;
    }

    container.style.display = 'block';
    carrossel.innerHTML = '';

    brindes.forEach(brinde => {
      const slide = document.createElement('div');
      slide.className = 'vz-brinde-slide';
      const title = brinde.title || 'Brinde';
      const image = brinde.image || 'https://via.placeholder.com/50';
      
      slide.innerHTML = `
        <img src="${image}" alt="${title}">
        <div>
          <div style="font-weight:bold; color:#54b101;font-size:12px;">🎁 ${title}</div>
          <div style="font-size:12px; color:#666;">ganhou!</div>
        </div>
      `;
      carrossel.appendChild(slide);
    });

    carrossel.style.transform = 'translateX(0)';

    if (brindes.length > 1) {
      let current = 0;
      
      this.brindeCarrosselInterval = setInterval(() => {
        if (!carrossel.isConnected) {
          clearInterval(this.brindeCarrosselInterval);
          this.brindeCarrosselInterval = null;
          return;
        }
        
        current = (current + 1) % brindes.length;
        carrossel.style.transform = `translateX(-${current * 100}%)`;
      }, 3000);
    }
  },

  async updateQty(key, qty) {
    if (qty < 0) return;
    
    const itemElement = event?.target?.closest('.vz-carrinho-item');
    const targetBtn = event?.target;
    const isRemoveBtn = qty === 0;
    
    if (itemElement) {
      itemElement.classList.add('updating');
      
      const buttons = itemElement.querySelectorAll('button');
      buttons.forEach(btn => btn.disabled = true);
    }
    
    let originalHTML;
    if (isRemoveBtn && targetBtn) {
      originalHTML = targetBtn.innerHTML;
      targetBtn.innerHTML = `
        <svg class="vz-loading-spinner" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <circle cx="12" cy="12" r="10" stroke-width="4" stroke-opacity="0.25"/>
          <path d="M12 2a10 10 0 0 1 10 10" stroke-width="4" stroke-linecap="round">
            <animateTransform attributeName="transform" type="rotate" from="0 12 12" to="360 12 12" dur="1s" repeatCount="indefinite"/>
          </path>
        </svg>
      `;
    }
    
    try {
      const response = await fetch('/cart/change.js', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({id: key, quantity: qty})
      });
      
      if (!response.ok) throw new Error('Erro ao atualizar');
      
      const cart = await response.json();
      
      if (itemElement && qty > 0) {
        itemElement.style.transition = 'all 0.3s ease';
        itemElement.style.transform = 'scale(1.02)';
        itemElement.style.background = 'rgba(84, 177, 1, 0.05)';
        
        setTimeout(() => {
          itemElement.style.transform = 'scale(1)';
          itemElement.style.background = '';
        }, 300);
    }
      
      this.processarCarrinho(cart);
      
    } catch(e) {
      if (this.config.debug) console.error('Erro ao atualizar:', e);
      
      if (itemElement) {
        itemElement.classList.remove('updating');
        const buttons = itemElement.querySelectorAll('button');
        buttons.forEach(btn => btn.disabled = false);
      }
      
      if (isRemoveBtn && targetBtn && originalHTML) {
        targetBtn.innerHTML = originalHTML;
      }
      
     /* this.falar('Ops! Erro ao atualizar. Tente novamente.');*/
      
    } finally {
      if (itemElement) {
        setTimeout(() => {
          itemElement.classList.remove('updating');
          const buttons = itemElement.querySelectorAll('button');
          buttons.forEach(btn => btn.disabled = false);
        }, 300);
      }
    }
  },

  transformarEmChat() {
    const gaveta = document.getElementById('vz-gaveta');
