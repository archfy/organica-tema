  flex: 0 0 30%;
  text-align: center;
  color: #000;
  font-size: 12px;
  text-decoration: none;
  border-radius: 12px;
  transition: all 0.2s ease;
  cursor: pointer;
  overflow: hidden;
  font-style: italic;
  text-decoration: underline;
}

.vz-continuar-comprando:hover {
  
  transform: scale(1.02);
}

.vz-continuar-comprando:active {
  transform: scale(0.98);
}

