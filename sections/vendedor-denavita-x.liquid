/* === ÍCONES NA BARRA === */
.item-circle {
  width: 29px;
  height: 29px;
  display: flex;
  background: #e0e0e0; /* Cinza quando não alcançado */
  border-radius: 50%;
  position: absolute;
  bottom: -129%; /* Ajuste conforme necessário */
  justify-content: center;
  align-items: center;
  transform: translate(-50%);
  transition: all 0.3s ease;
  border: 1px solid #f0f0f0;
}

.item-circle.achieved {
  background: #54B101;
  animation: pulse 1s ease;
}

.item-circle svg {
  width: 17px;
  height: 17px;
  stroke: #f0f0f0;
}

.item-circle span {
  position: absolute;
  top: 75%;
  left: 50%;
  transform: translate(-50%);
  margin-top: 10px;
  text-align: center;
  max-width: 50px;
  line-height: 1;
  font-size: 10px;
  color: #666;
  font-weight: 500;
}

/* Tamanhos progressivos */
.item-circle[data-index="0"] {
  left: 25.287%;
  width: 29px;
  height: 29px;
  bottom: -129%;
}

.item-circle[data-index="1"] {
  left: 50%;
  width: 32px;
  height: 32px;
  bottom: -142%;
}

.item-circle[data-index="2"] {
  left: 70.287%;
  width: 34px;
  height: 34px;
  bottom: -150%;
}

.item-circle[data-index="3"] {
  left: 100%;
  width: 40px;
  height: 40px;
  bottom: -184%;
}

@keyframes pulse {
  0%, 100% { transform: translate(-50%) scale(1); }
  50% { transform: translate(-50%) scale(1.1); }
}

// === ADICIONAR CSS PARA TRANSIÇÃO ===
