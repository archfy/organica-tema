  atualizarTrilha() {
    const valorComDesconto = this.carrinho_valor - (this.carrinho_valor * this.descontoPercentual / 100);
    
    const items = document.querySelectorAll('.vz-trilha-item');
    const progresso = document.getElementById('vz-trilha-progresso');
    let percentualProgresso = 0;
    let itemsConquistados = 0;
    
    items.forEach((item, index) => {
      const valorItem = parseFloat(item.dataset.valor);
      if (valorComDesconto >= valorItem && valorItem > 0) {
        item.classList.add('conquistado');
        item.classList.remove('ativo');
        itemsConquistados++;
      } else if (index === itemsConquistados) {
        item.classList.add('ativo');
        item.classList.remove('conquistado');
      } else {
        item.classList.remove('ativo', 'conquistado');
      }
    });
    
    const marcos = [
      { valor: this.config.frete_gratis, peso: 25 },
      { valor: this.config.brinde1_valor, peso: 50 },
      { valor: this.config.brinde2_valor, peso: 75 },
      { valor: this.config.brinde3_valor, peso: 100 }
    ].filter(m => m.valor > 0).sort((a, b) => a.valor - b.valor);
    
    if (marcos.length === 0) {
      percentualProgresso = 0;
    } else {
      const maxMarco = marcos[marcos.length - 1];
      
      if (valorComDesconto >= maxMarco.valor) {
        percentualProgresso = 100;
      } else {
        const proximoMarco = marcos.find(m => valorComDesconto < m.valor);
        if (!proximoMarco) {
          percentualProgresso = 100;
        } else {
          const indice = marcos.indexOf(proximoMarco);
          const marcoAnterior = indice > 0 ? marcos[indice - 1] : null;
          
          if (marcoAnterior) {
            const rangeValor = proximoMarco.valor - marcoAnterior.valor;
            const rangePeso = proximoMarco.peso - marcoAnterior.peso;
            const progressoNoRange = valorComDesconto - marcoAnterior.valor;
            percentualProgresso = marcoAnterior.peso + (progressoNoRange / rangeValor) * rangePeso;
          } else {
            const primeiroMarco = marcos[0];
            percentualProgresso = (valorComDesconto / primeiroMarco.valor) * primeiroMarco.peso;
          }
        }
      }
    }
    
    if (progresso) {
      progresso.style.width = Math.min(Math.max(percentualProgresso, 0), 100) + '%';
    }
  },

  async adicionarAoCarrinho(variant_id) {
    try {
      // ✅ OTIMIZAÇÃO: Uma única requisição
      const response = await fetch('/cart/add.js', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({
          id: variant_id,
          quantity: 1
        })
      });
      
      if (!response.ok) throw new Error('Falha ao adicionar');
      
      // ✅ OTIMIZAÇÃO: Usa resposta direta do /cart/add.js
      const cart = await response.json();
      
      // ✅ OTIMIZAÇÃO: Atualiza imediatamente sem debounce
      await this.processarCarrinho(cart);
      
      this.abrirCarrinho();
      /*this.falar('Produto adicionado! 🛒');*/
    } catch(e) {
      if (this.config.debug) console.error('Erro ao adicionar:', e);
     /* this.falar('Ops! Erro ao adicionar.');*/
    }
  },

  abrirCarrinho() {
  const carrinho = document.getElementById('vz-carrinho');
  const overlay = document.getElementById('vz-carrinho-overlay');
  
  if (carrinho) {
    carrinho.classList.add('aberto');
    this.estado_atual = 'carrinho_aberto';
  }
  
  if (overlay) {
    overlay.classList.add('ativo');
  }
  
  this.renderCarrinho();
},

  // ✅ NOVA FUNÇÃO: renderCarrinho() - busca carrinho e atualiza UI imediatamente
  async renderCarrinho() {
    try {
      const response = await fetch('/cart.js');
      if (!response.ok) throw new Error('Falha ao buscar carrinho');
      
      const cart = await response.json();
      await this.processarCarrinho(cart);
    } catch (e) {
      if (this.config.debug) console.error('❌ Erro em renderCarrinho:', e);
    }
  },
  
  // ✅ NOVA FUNÇÃO: Trigger para forçar checagem imediata (usado após adicionar)
  forcarAtualizacao() {
    // Força checagem imediata sem await (não bloqueia)
    setTimeout(() => {
      this.checarCarrinho();
    }, 100);
  },
  

  fecharCarrinho() {
  const carrinho = document.getElementById('vz-carrinho');
