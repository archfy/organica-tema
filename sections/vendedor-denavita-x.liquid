        'prazo': 'Entregamos em 3-7 dias úteis!',
        'troca': 'Trocas em até 30 dias!',
        'pagamento': 'Aceitamos cartão, boleto e PIX!',
        'desconto': 'Use o cupom PRIMEIRA10 para 10% off!'
      };
      
      let resposta = 'Ótima pergunta! Entre em contato pelo WhatsApp para mais detalhes!';
      Object.keys(respostas).forEach(key => {
        if (texto.toLowerCase().includes(key)) {
          resposta = respostas[key];
        }
      });
      
      this.addMensagem('vendor', resposta);
    }, 1000);
  },

  celebrar() {
    if (!this.config.confetti) return;
    
    const canvas = document.getElementById('vz-confetti-canvas');
    if (!canvas) return;
    
    const ctx = canvas.getContext('2d');
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
    
    const particles = [];
    for (let i = 0; i < 50; i++) {
      particles.push({
        x: Math.random() * canvas.width,
        y: 0,
        size: Math.random() * 10 + 5,
        speed: Math.random() * 5 + 2,
        color: `hsl(${Math.random() * 360}, 100%, 50%)`,
        rotation: Math.random() * 360,
        rotSpeed: Math.random() * 10 - 5
      });
    }
    
    function animate() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      particles.forEach(p => {
        p.y += p.speed;
        p.rotation += p.rotSpeed;
        ctx.save();
        ctx.translate(p.x, p.y);
        ctx.rotate(p.rotation * Math.PI / 180);
        ctx.fillStyle = p.color;
        ctx.fillRect(-p.size / 2, -p.size / 2, p.size, p.size);
        ctx.restore();
        if (p.y > canvas.height) p.y = 0;
      });
      requestAnimationFrame(animate);
    }
    
    animate();
    setTimeout(() => ctx.clearRect(0, 0, canvas.width, canvas.height), 3000);
  }
};

