  pararMonitoramento() {
    if (this.monitorCarrinhoInterval) {
      clearInterval(this.monitorCarrinhoInterval);
      this.monitorCarrinhoInterval = null;
      this.isMonitoring = false;
      
      if (this.config.debug) console.log('🛑 Monitoramento parado');
    }
  },

 processarCarrinho(cart) {
      // ✅ CACHE UNIFICADO: Valida tudo de uma vez
      const valor_sem_brindes = this.calcularValorSemBrindes(cart);
      const brindesAtuais = cart.items
        .filter(item => item.properties && item.properties._brinde)
        .map(b => b.key)
        .sort()
        .join(',');
      
      const agora = Date.now();
      const tempoDesdeUltimo = agora - this.carrinhoCache.lastUpdate;
      
      // Verifica se realmente precisa atualizar
      const precisaAtualizar = (
        // Mudou algo importante
        valor_sem_brindes !== this.carrinho_valor ||
        brindesAtuais !== this.ultimosBrindesKeys ||
        cart.item_count !== this.ultimoItemCount ||
        // OU passou tempo suficiente desde última atualização
        tempoDesdeUltimo > 2000
      );
      
      // Skip se não mudou e foi recente
      if (!precisaAtualizar) {
        if (this.config.debug) console.log('⚡ Cache - skip update');
        return;
      }
      
      // Atualiza TODOS os caches
      this.carrinho_valor = valor_sem_brindes;
      this.cart_items = cart.items;
      this.ultimosBrindesKeys = brindesAtuais;
      this.ultimoItemCount = cart.item_count;
      this.carrinhoCache.itemCount = cart.item_count;
      this.carrinhoCache.totalPrice = cart.total_price;
      this.carrinhoCache.lastUpdate = agora;
      
      // ✅ OTIMIZAÇÃO: Atualiza UI de forma síncrona (rápido)
      this.atualizarProgresso();
      
      if (this.config.modo_gaveta === 'trilha') {
        this.atualizarTrilha();
      }
      
      this.atualizarCarrinhoUI(cart);
      this.atualizarBadge(cart.item_count);
      
      // ✅ OTIMIZAÇÃO: Gerenciar brindes de forma assíncrona (não bloqueia UI)
      const valorComDesconto = this.carrinho_valor - (this.carrinho_valor * this.descontoPercentual / 100);
      this.gerenciarBrindes(valorComDesconto, cart);
  },

  atualizarBadge(count) {
  // Atualiza nosso badge (se existir)
  const badge = document.getElementById('vz-badge');
  if (badge) badge.textContent = count;
  
  // ✅ NOVO: Sincroniza contador do header nativo do tema
  // Procura por todos os contadores de carrinho no DOM
  const contadoresNativos = document.querySelectorAll(
    '.cart-count, .h-count, #cart-icon-bubble .cart-count, ' +
    '[class*="cart-count"], [class*="minicart-count"], ' +
    '[id*="cart-count"], .header__icon--cart .icon__fallback-text, ' +
    '.cart-link__bubble, [data-cart-count]'
  );
  
  contadoresNativos.forEach(contador => {
    // Atualiza o texto do contador
    contador.textContent = count;
    
    // Se for um elemento com data-attribute, atualiza também
    if (contador.hasAttribute('data-cart-count')) {
      contador.setAttribute('data-cart-count', count);
    }
  });
  
  // ✅ NOVO: Atualiza contador dentro de links
  const linkCartCount = document.querySelector('#cart-icon-bubble .cart-count, #cart-icon-bubble .h-count');
  if (linkCartCount) {
    linkCartCount.textContent = count;
  }
  
  // ✅ NOVO: Dispara evento customizado para outros scripts do tema
  window.dispatchEvent(new CustomEvent('cart:updated', {
    detail: { itemCount: count }
  }));
  
  if (this.config.debug) console.log('✅ Contadores sincronizados:', count);
},

  calcularValorSemBrindes(cart) {
    let total = 0;
    cart.items.forEach(item => {
      if (!item.properties || !item.properties._brinde) {
        total += item.line_price;
      }
    });
    return total / 100;
  },

  async gerenciarBrindes(valor, cart) {
    if (this.brindeLock) return;
    this.brindeLock = true;

    try {
      const tem_brinde1 = cart.items.some(item => 
        item.properties && item.properties._brinde && item.properties._numero == 1
      );
      const tem_brinde2 = cart.items.some(item => 
        item.properties && item.properties._brinde && item.properties._numero == 2
      );
      const tem_brinde3 = cart.items.some(item => 
        item.properties && item.properties._brinde && item.properties._numero == 3
      );

      if (valor >= this.config.brinde1_valor && !tem_brinde1) {
        await this.adicionarBrinde(1);
      } else if (valor < this.config.brinde1_valor && tem_brinde1) {
        await this.removerBrinde(1, cart);
      }

      if (valor >= this.config.brinde2_valor && !tem_brinde2) {
        await this.adicionarBrinde(2);
      } else if (valor < this.config.brinde2_valor && tem_brinde2) {
        await this.removerBrinde(2, cart);
      }

      if (valor >= this.config.brinde3_valor && !tem_brinde3) {
        await this.adicionarBrinde(3);
      } else if (valor < this.config.brinde3_valor && tem_brinde3) {
        await this.removerBrinde(3, cart);
      }
    } catch (e) {
      if (this.config.debug) console.error('Erro em gerenciarBrindes:', e);
    } finally {
      setTimeout(() => {
        this.brindeLock = false;
      }, 1500);
    }
  },

  async adicionarBrinde(numero) {
    let variant_id;
    if (numero === 1) variant_id = this.config.brinde1_id;
    else if (numero === 2) variant_id = this.config.brinde2_id;
    else if (numero === 3) variant_id = this.config.brinde3_id;
    if (!variant_id) return;
    
    try {
      await fetch('/cart/add.js', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({
          id: variant_id,
          quantity: 1,
          properties: {
            '_brinde': true,
            '_numero': numero
          }
        })
      });
      if (this.config.confetti) this.celebrar();
     /* this.falar(`Você ganhou o brinde ${numero}! 🎁`);*/
    } catch(e) {
      if (this.config.debug) console.error('Erro ao adicionar brinde:', e);
    }
  },

  async removerBrinde(numero, cart) {
    const item = cart.items.find(i => 
      i.properties && i.properties._brinde && i.properties._numero == numero
    );
    if (!item) return;
    
    try {
      await fetch('/cart/change.js', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({
          id: item.key,
          quantity: 0
        })
      });
     /* this.falar(`Você perdeu o brinde ${numero}... 😢`);*/
    } catch(e) {
      if (this.config.debug) console.error('Erro ao remover brinde:', e);
    }
  },

