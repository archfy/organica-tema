}

@keyframes fadeOut {
  from {
    /*opacity: 1;*/
    max-height: 100px;
    margin-bottom: 10px;
  }
  to {
    /*opacity: 0;*/
    max-height: 0;
    margin-bottom: 0;
    padding: 0;
    overflow: hidden;
  }
}

.vz-fade-in {
  animation: vzFadeInCustom 0.5s ease forwards;
}

@keyframes vzFadeInCustom {
  from {
    opacity: 0;
    max-height: 0;
  }
  to {
    opacity: 1;
    max-height: 100px;
  }
}
  
