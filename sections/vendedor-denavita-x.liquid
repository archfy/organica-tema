  carregarCupomSalvo() {
    try {
      const cupomSalvo = sessionStorage.getItem('vz_cupom_ativo');
      const descontoSalvo = sessionStorage.getItem('vz_desconto_percentual');
      
      if (cupomSalvo && descontoSalvo && cupomSalvo !== 'null' && descontoSalvo !== '0') {
        this.cupomAtual = cupomSalvo;
        this.descontoPercentual = parseFloat(descontoSalvo);
        this.renderCupomAplicado();
        if (this.config.debug) console.log('✅ Cupom restaurado:', cupomSalvo, descontoSalvo + '%');
      } else {
        sessionStorage.removeItem('vz_cupom_ativo');
        sessionStorage.removeItem('vz_desconto_percentual');
        if (this.config.debug) console.log('🧹 SessionStorage limpo (sem cupom válido)');
      }
    } catch (e) {
      if (this.config.debug) console.error('Erro ao carregar cupom salvo:', e);
      sessionStorage.removeItem('vz_cupom_ativo');
      sessionStorage.removeItem('vz_desconto_percentual');
    }
  },

  salvarCupom() {
    try {
      if (this.cupomAtual && this.descontoPercentual > 0) {
        sessionStorage.setItem('vz_cupom_ativo', this.cupomAtual);
        sessionStorage.setItem('vz_desconto_percentual', this.descontoPercentual.toString());
        if (this.config.debug) console.log('💾 Cupom salvo:', this.cupomAtual, this.descontoPercentual + '%');
      } else {
        sessionStorage.removeItem('vz_cupom_ativo');
        sessionStorage.removeItem('vz_desconto_percentual');
        if (this.config.debug) console.log('🗑️ Cupom removido do storage');
      }
    } catch (e) {
      if (this.config.debug) console.error('Erro ao salvar cupom:', e);
    }
  },

  async aplicarCupom(event) {
    event.preventDefault();
    
    const input = document.getElementById('vz-cupom-input');
    const msg = document.getElementById('vz-cupom-msg');
    const codigo = input.value.trim().toUpperCase();

    if (!codigo) {
      msg.textContent = 'Digite um cupom válido';
      msg.className = 'vz-cupom-msg error';
      return;
    }

    msg.textContent = 'Validando...';
    msg.className = 'vz-cupom-msg';

    try {
      // ✅ NOVA VALIDAÇÃO: Via API Shopify em vez de array fixo
      // Tenta aplicar o cupom diretamente no carrinho da Shopify
      const validateResponse = await fetch('/discount/' + encodeURIComponent(codigo));
      
      if (!validateResponse.ok) {
        throw new Error('Cupom inválido');
      }
      
      // Busca informações do carrinho para verificar se o desconto foi aplicado
      const cartResponse = await fetch('/cart.js');
      const cartData = await cartResponse.json();
      
      // Extrai o valor do desconto do carrinho
      // A Shopify retorna o desconto em centavos
      let novoDesconto = 0;
      
      if (cartData.total_discount > 0) {
        // Calcula percentual baseado no desconto aplicado
        const subtotal = cartData.items_subtotal_price || cartData.total_price + cartData.total_discount;
        novoDesconto = Math.round((cartData.total_discount / subtotal) * 100);
      } else {
        // Se não conseguiu calcular, tenta extrair do código do cupom
        // Muitos cupons seguem padrão como "10OFF", "15PRAVC", etc
        const match = codigo.match(/(\d+)/);
        if (match) {
          novoDesconto = parseInt(match[1]);
        } else {
          // Assume 10% como fallback se não conseguir determinar
          novoDesconto = 10;
        }
      }
      
      if (novoDesconto === 0) {
        throw new Error('Cupom inválido ou sem desconto');
      }
      
      if (this.cupomAtual && this.descontoPercentual > 0) {
        if (novoDesconto > this.descontoPercentual) {
          /*this.falar(`Cupom ${codigo} (${novoDesconto}%) substituiu ${this.cupomAtual} (${this.descontoPercentual}%)!`);
        */} else if (novoDesconto === this.descontoPercentual) {
          msg.textContent = `⚠️ Cupom ${codigo} tem o mesmo valor do atual (${this.descontoPercentual}%)`;
          msg.className = 'vz-cupom-msg error';
          return;
        } else {
          msg.textContent = `⚠️ Cupom atual (${this.descontoPercentual}%) é melhor que ${codigo} (${novoDesconto}%)`;
          msg.className = 'vz-cupom-msg error';
          return;
        }
      }

      this.descontoPercentual = novoDesconto;
      this.cupomAtual = codigo;
      
      this.salvarCupom();
      
      this.recalcularTotais();
      
      msg.textContent = `✓ Cupom ${codigo} aplicado! ${novoDesconto}% de desconto`;
      msg.className = 'vz-cupom-msg success';
      input.value = '';
      this.renderCupomAplicado();
     /* this.falar(`Cupom ${codigo} pronto! Clique em "Finalizar" para usar! 🎉`);*/

      setTimeout(() => {
        msg.classList.add('vz-fade-out');
      }, 1000);

      setTimeout(() => {
        const descontoEl = document.getElementById('vz-cart-desconto');
        if (descontoEl && descontoEl.parentElement) {
          descontoEl.parentElement.classList.add('vz-fade-out');
        }
      }, 3000);

    } catch (e) {
      msg.textContent = '✗ Cupom inválido ou expirado';
      msg.className = 'vz-cupom-msg error';
      if (this.config.debug) console.error('Erro ao validar cupom:', e);
    }
  },

  renderCupomAplicado() {
    const container = document.getElementById('vz-cupom-aplicado-container');
    const form = document.getElementById('vz-cupom-form');
    
    if (!this.cupomAtual) {
      container.innerHTML = '';
      if (form) form.style.display = 'flex';
      return;
    }

    container.innerHTML = `
      <div class="vz-cupom-aplicado">
        <div class="vz-cupom-tag">${this.cupomAtual}</div>
        <button 
          class="vz-cupom-remove" 
          onclick="VZ.removerCupom()"
          aria-label="Remover cupom"
        >×</button>
      </div>
    `;
    
    if (form) form.style.display = 'none';
  },

  async removerCupom() {
    this.cupomAtual = null;
    this.descontoPercentual = 0;
    this.descontoValor = 0;
    
    this.salvarCupom();
    
    this.recalcularTotais();
    this.renderCupomAplicado();
    
    const msg = document.getElementById('vz-cupom-msg');
    if (msg) {
      msg.textContent = '';
      msg.className = 'vz-cupom-msg';
      msg.classList.remove('vz-fade-out');
    }
    
    const descontoEl = document.getElementById('vz-cart-desconto');
    
    if (descontoEl && descontoEl.parentElement) {
      descontoEl.parentElement.classList.remove('vz-fade-out');
      descontoEl.parentElement.classList.add('vz-fade-in');
    }
    
    /*this.falar('Cupom removido');*/
  },

  // ✅ INTEGRAÇÃO COM YAMPI CHECKOUT
  // ========================================
  
  async finalizarCompraYampi() {
    try {
      const btnFinalizar = document.querySelector('.vz-btn-finalizar, [onclick*="finalizarCompraYampi"]');
      if (btnFinalizar) {
        btnFinalizar.disabled = true;
        btnFinalizar.textContent = 'Processando...';
      }
      
      if (this.config.debug) console.log('🔄 Finalizando compra com Yampi...');
      
      const response = await fetch('/cart.json');
      if (!response.ok) throw new Error('Erro ao buscar carrinho');
      const cartData = await response.json();
      
      if (this.config.debug) {
        console.log('📦 Carrinho:', cartData);
        console.log('🎟️ Cupom:', this.cupomAtual);
      }
      
      const data = {
        shop: window.location.host,
        shopify_internal_domain: typeof shopifyInternalUrl !== 'undefined' ? shopifyInternalUrl : '',
        cart_payload: cartData
      };
      
      const yampiResponse = await fetch('https://api.dooki.com.br/v2/public/shopify/cart', {
        method: 'POST',
        headers: {
          'X-Requested-With': 'XMLHttpRequest',
          'Content-Type': 'application/json'
        },
        body: JSON.stringify(data)
      });
      
      if (!yampiResponse.ok) throw new Error('Erro na API Yampi');
      const yampiData = await yampiResponse.json();
      
      if (!yampiData.checkout_direct_url) {
        throw new Error('URL de checkout não retornada');
      }
      
      let checkoutUrl = yampiData.checkout_direct_url;
      
      if (this.config.debug) console.log('🔗 URL base:', checkoutUrl);
      
      if (this.cupomAtual) {
        checkoutUrl = this.adicionarCupomNaUrl(checkoutUrl, this.cupomAtual);
        if (this.config.debug) console.log('🔗 URL com cupom:', checkoutUrl);
      }
      
      if (typeof ymp_getUrlWithUtms === 'function') {
        checkoutUrl = ymp_getUrlWithUtms(checkoutUrl);
      }
      
      if (this.config.debug) console.log('✅ Redirecionando...');
      window.location.href = checkoutUrl;
      
    } catch (error) {
      console.error('❌ Erro:', error);
      const btnFinalizar = document.querySelector('.vz-btn-finalizar, [onclick*="finalizarCompraYampi"]');
      if (btnFinalizar) {
        btnFinalizar.disabled = false;
        btnFinalizar.textContent = 'Finalizar Compra';
      }
      alert('Erro ao finalizar compra. Tente novamente.');
    }
  },
  
  adicionarCupomNaUrl(url, cupom) {
    try {
      const urlObj = new URL(url);
      urlObj.searchParams.set('promocode', cupom.toUpperCase());
      return urlObj.toString();
    } catch (error) {
      const separator = url.includes('?') ? '&' : '?';
      return `${url}${separator}promocode=${cupom.toUpperCase()}`;
    }
  },

  recalcularTotais() {
    const subtotal = this.carrinho_valor;
    
    this.descontoValor = (subtotal * this.descontoPercentual) / 100;
    
    const totalComDesconto = subtotal - this.descontoValor;
    
    const total = totalComDesconto;

    const descontoLine = document.getElementById('vz-desconto-line');
    if (this.descontoValor > 0 && descontoLine) {
      descontoLine.style.display = 'flex';
      const percentEl = document.getElementById('vz-desconto-percent');
      const valorEl = document.getElementById('vz-cart-desconto');
      if (percentEl) percentEl.textContent = this.descontoPercentual + '%';
      if (valorEl) valorEl.textContent = '-R$ ' + this.descontoValor.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    } else if (descontoLine) {
      descontoLine.style.display = 'none';
    }

    const totalEl = document.getElementById('vz-cart-total');
    if (totalEl) {
      totalEl.textContent = 'R$ ' + total.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    this.atualizarParcelamento(total);
    
    this.atualizarProgressoComDesconto(totalComDesconto);
  },

  atualizarProgressoComDesconto(valorComDesconto) {
    const barra = document.querySelectorAll('.vz-progress-fill');
    const msgs = document.querySelectorAll('.vz-progress-msg');
    
    let percent = 0;
    let mensagem = '';
    
    const milestones = [
      { valor: this.config.frete_gratis, nome: 'frete grátis' },
      { valor: this.config.brinde1_valor, nome: 'brinde 1' },
      { valor: this.config.brinde2_valor, nome: 'brinde 2' },
      { valor: this.config.brinde3_valor, nome: 'brinde 3' }
    ];
    const milestonesValidos = milestones.filter(m => m.valor && m.valor > 0 && !isNaN(m.valor)).sort((a, b) => a.valor - b.valor);
    
    const maxValor = milestonesValidos.length > 0 ? milestonesValidos[milestonesValidos.length - 1].valor : this.config.frete_gratis;
    
    if (valorComDesconto >= maxValor) {
      percent = 100;
      const ultimoMarco = milestonesValidos[milestonesValidos.length - 1];
      mensagem = milestonesValidos.length === 1 ? `🎉 Parabéns! ${ultimoMarco.nome} conquistado!` : '🎉 Parabéns! Todas as metas desbloqueadas!';
    } else {
      percent = (valorComDesconto / maxValor) * 100;
      
      const proximaMeta = milestonesValidos.find(m => valorComDesconto < m.valor);
      if (proximaMeta) {
        const falta = (proximaMeta.valor - valorComDesconto).toFixed(2);
        mensagem = `Falta R$ ${falta} para ${proximaMeta.nome}!`;
      }
    }
    
    barra.forEach(b => b.style.width = percent + '%');
    msgs.forEach(m => m.textContent = mensagem);
    
    document.querySelectorAll('.item-circle').forEach((circle) => {
      const minValue = parseFloat(circle.dataset.minvalue);
      
      if (minValue > 0 && valorComDesconto >= minValue) {
        circle.classList.add('achieved');
      } else {
        circle.classList.remove('achieved');
      }
    });
  },

  atualizarParcelamento(total) {
    const parcelamento = document.getElementById('vz-parcelamento');
    if (!parcelamento) return;

    const minParcela = 49.98; // R$49,98 mínimo por parcela
    let numParcelas = 0;

    if (total < minParcela * 2) {
      // Se não dá pra dividir em 2x com parcela >= R$49,98: sem parcelamento
      numParcelas = 0;
    } else {
      // Calcula máximo de parcelas onde cada uma >= R$49,98
      numParcelas = Math.floor(total / minParcela);
      if (numParcelas > 10) numParcelas = 10;
      if (numParcelas < 2) numParcelas = 2;

      // Validação final: garante que parcela >= R$49,98
      if ((total / numParcelas) < minParcela) {
        numParcelas = 0;
      }
    }

    if (numParcelas > 0) {
      const valorParcela = (total / numParcelas).toLocaleString('pt-BR', { 
        minimumFractionDigits: 2, 
        maximumFractionDigits: 2 
      });
      parcelamento.textContent = `ou ${numParcelas}x de R$ ${valorParcela} sem juros`;
      parcelamento.style.display = '';
    } else {
      parcelamento.textContent = '';
      parcelamento.style.display = 'none';
    }
  },


async irParaCheckout() {
  try {
    // ✅ SE TEM CUPOM, APLICA AGORA (no momento do clique)
    if (this.cupomAtual) {
      if (this.config.debug) console.log('🎟️ Aplicando cupom no checkout:', this.cupomAtual);
        
        try {
          await fetch('/cart/update.js', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({
              attributes: {
                'discount_code': this.cupomAtual
              }
            })
          });
        } catch (e) {
          if (this.config.debug) console.warn('⚠️ Falha ao salvar no cart, usando URL:', e);
        }
        
        const url = `/checkout?promocode=${encodeURIComponent(this.cupomAtual)}`;
        
        if (this.config.debug) console.log('🛒 Redirecionando:', url);
        window.location.href = url;
        
      } else {
        if (this.config.debug) console.log('🛒 Checkout sem cupom');
        window.location.href = '/checkout';
      }
    } catch (e) {
      if (this.config.debug) console.error('❌ Erro no checkout:', e);
      window.location.href = '/checkout';
    }
  },

  init() {
    if (this.config.debug) console.log('🖐️ Vendedor Zueiro iniciando...');
