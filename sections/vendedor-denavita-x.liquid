  }
}

/* iPhone específico: Garantir visibilidade */
@media only screen 
  and (min-device-width: 375px) 
  and (max-device-width: 430px) 
  and (-webkit-min-device-pixel-ratio: 2) {
  .vz-checkout-container {
    padding-bottom: max(env(safe-area-inset-bottom, 15px), 15px);
    min-height: 70px;
  }
  
  .vz-carrinho-footer {
    padding-bottom: 15px;
  }
}

  .vz-chat {
    display: none;
    padding: var(--vz-spacing);
    background: #f8f9fa;
    height: 100%;
  }
  .vz-chat.active {
    display: flex;
    flex-direction: column;
  }
  .vz-messages {
    flex: 1;
    max-height: 60vh;
    overflow-y: auto;
    scroll-behavior: smooth;
    background: white;
    border-radius: 10px;
    padding: 10px;
    margin-bottom: 10px;
  }
  .vz-msg {
    padding: 8px 12px;
    border-radius: 10px;
    margin: 5px 0;
    max-width: 70%;
  }
  .vz-msg-vendor {
    background: #e8f5e9;
  }
  .vz-msg-customer {
    background: #f3e5f5;
    margin-left: auto;
    text-align: right;
  }
  .vz-input-area {
    display: flex;
    gap: 10px;
  }
  .vz-input {
    flex: 1;
    padding: 10px;
    border: 2px solid #ddd;
    border-radius: 5px;
  }
  .vz-send {
    padding: 10px 20px;
