    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Cor de Fundo do Botão",
      "default": "#FF5A5F"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Cor do Texto do Botão",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "button_padding_y",
      "min": 10, "max": 30, "step": 1, "unit": "px", "label": "Preenchimento Vertical do Botão",
      "default": 18
    },
    {
      "type": "range",
      "id": "button_padding_x",
      "min": 20, "max": 150, "step": 5, "unit": "px", "label": "Preenchimento Horizontal do Botão",
      "default": 100
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "min": 0, "max": 50, "step": 1, "unit": "px", "label": "Raio da Borda do Botão",
      "default": 50
    },
    {
      "type": "select",
      "id": "button_align",
      "label": "Alinhamento do Botão",
      "options": [
        { "value": "left", "label": "Esquerda" },
        { "value": "center", "label": "Centro" },
        { "value": "right", "label": "Direita" }
      ],
      "default": "center"
    }
  ],
  "blocks": [
    {
      "type": "composition_item",
      "name": "Item de Composição",
      "settings": [
        {
          "type": "header",
          "content": "Layout e Cores do Item"
        },
        {
          "type": "text",
          "id": "block_title",
          "label": "Título do Item",
          "default": "INGREDIENTE PRINCIPAL"
        },
        {
          "type": "richtext",
