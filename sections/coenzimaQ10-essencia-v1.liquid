        },
        {
          "type": "header",
          "content": "Cores e Fontes do Texto"
        },
        {
          "type": "color",
          "id": "block_title_color",
          "label": "Cor do Título do Bloco",
          "default": "#333333"
        },
        {
          "type": "range",
          "id": "block_title_size",
          "min": 14, "max": 28, "step": 1, "unit": "px", "label": "Tamanho da Fonte do Título",
          "default": 20
        },
        {
          "type": "select",
          "id": "block_title_weight",
          "label": "Peso da Fonte do Título",
          "options": [
            { "value": "400", "label": "Normal" },
            { "value": "500", "label": "Medium" },
            { "value": "600", "label": "Semi-bold" },
            { "value": "700", "label": "Bold" }
          ],
          "default": "700"
        },
        {
