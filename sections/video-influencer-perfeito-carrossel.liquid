           class="btn-2x8 {% if section.settings.ancorax8 != blank %}btn-compra-2-{{ section.id }}{% endif %}"
           {% if section.settings.ancorax8 == blank %}target="_blank"{% endif %}
        >
          {{ section.settings.btn_lblx8_text }}
        </a>
      </div>
    {%- endif -%}

  </div>
</section>

<script>
  
 document.addEventListener('DOMContentLoaded', function() {
   // Sua lógica de scroll de âncora permanece a mesma...
  const scrollButtons = document.querySelectorAll('.btn-compra-2-{{ section.id }}');
  scrollButtons.forEach(button => {
    button.addEventListener('click', function(e) {
      e.preventDefault();
      const href = this.getAttribute('href');
      if (href && href.startsWith('#')) {
        const targetElement = document.querySelector(href);
        if (targetElement) {
          const offset = 100;
          window.scrollTo({
            top: targetElement.offsetTop - offset,
            behavior: 'smooth'
          });
        }
      }
    });
  });
  const sectionId = '{{ section.id }}';
  const carouselContainer = document.querySelector(`.video-carousel-containerx8[data-section-id="${sectionId}"]`);

  if (carouselContainer) {
    const carouselWrapper = carouselContainer.querySelector('.video-carousel-wrapperx8');
    const carouselTrack = carouselContainer.querySelector('.video-carousel-trackx8');
    const slides = Array.from(carouselTrack.querySelectorAll('.video-carousel-slidex8:not(.clone)'));
    const allSlides = Array.from(carouselTrack.querySelectorAll('.video-carousel-slidex8'));
    const prevButton = carouselContainer.querySelector('.video-carousel-button--prevx8');
    const nextButton = carouselContainer.querySelector('.video-carousel-button--nextx8');
    const dotsContainer = carouselContainer.querySelector('.video-carousel-dotsx8');
    
    let currentSlideIndex = 0;
    const totalSlides = slides.length;

    // Posiciona inicialmente mostrando o último slide à esquerda
    function initializeInfinitePosition() {
      if (totalSlides > 1) {
        currentSlideIndex = 1; // Começa no primeiro slide real
        carouselTrack.style.transition = 'none';
        updateCarousel();
        
        // Força um reflow para aplicar a mudança sem animação
        void carouselTrack.offsetWidth;
        
        // Agora sim permite transições
        carouselTrack.style.transition = 'transform 0.5s ease';
      }
    }

    function updateCarousel() {
      // Atualiza navegação infinita
      if (currentSlideIndex >= totalSlides) {
        currentSlideIndex = 0;
        carouselTrack.style.transition = 'none';
        updateCarouselPosition();
        void carouselTrack.offsetWidth;
        carouselTrack.style.transition = 'transform 0.5s ease';
      } else if (currentSlideIndex < 0) {
        currentSlideIndex = totalSlides - 1;
        carouselTrack.style.transition = 'none';
        updateCarouselPosition();
        void carouselTrack.offsetWidth;
        carouselTrack.style.transition = 'transform 0.5s ease';
      } else {
        updateCarouselPosition();
      }

      // Atualiza UI
      updateActiveStates();
      handleVideoPlayback();
    }

    function updateCarouselPosition() {
      const activeSlide = allSlides[currentSlideIndex];
      const wrapperCenter = carouselWrapper.offsetWidth / 2;
      const activeSlideCenter = activeSlide.offsetLeft + activeSlide.offsetWidth / 2;
      const offset = wrapperCenter - activeSlideCenter;
      carouselTrack.style.transform = `translateX(${offset}px)`;
    }

    function updateActiveStates() {
      slides.forEach((slide, index) => {
        const realIndex = (currentSlideIndex % totalSlides + totalSlides) % totalSlides;
        slide.classList.toggle('is-active-slide', index === realIndex);
      });
      
      updateDots();
    }

    function updateDots() {
      if (!dotsContainer) return;
      dotsContainer.innerHTML = '';
      slides.forEach((_, index) => {
        const dot = document.createElement('span');
        dot.classList.add('video-carousel-dotx8');
        dot.classList.toggle('active', index === (currentSlideIndex % totalSlides));
        dot.addEventListener('click', () => {
          currentSlideIndex = index;
          updateCarousel();
        });
        dotsContainer.appendChild(dot);
      });
    }

    function handleVideoPlayback() {
      const realIndex = (currentSlideIndex % totalSlides + totalSlides) % totalSlides;
      
      slides.forEach((slide, index) => {
        const videoElement = slide.querySelector('video, iframe');
        if (!videoElement) return;

        const isActive = index === realIndex;
        const provider = videoElement.dataset.videoProvider;

        if (isActive) {
          if ('{{ section.settings.video_autoplay }}' === 'true') {
            if (provider === 'direct') {
              videoElement.play().catch(e => console.log("Autoplay bloqueado:", e));
            } else {
              const newSrc = videoElement.src.replace('autoplay=0', 'autoplay=1');
              if (videoElement.src !== newSrc) {
                videoElement.src = newSrc;
              }
            }
          }
        } else {
          if (provider === 'direct') {
            videoElement.pause();
            videoElement.currentTime = 0;
          } else {
            const newSrc = videoElement.src.replace('autoplay=1', 'autoplay=0');
            if (videoElement.src !== newSrc) {
              videoElement.src = newSrc;
            }
          }
        }
      });
    }

    // Event Listeners
    prevButton.addEventListener('click', () => {
      currentSlideIndex--;
      updateCarousel();
    });

    nextButton.addEventListener('click', () => {
      currentSlideIndex++;
      updateCarousel();
    });

    // Inicialização
    initializeInfinitePosition();
    window.addEventListener('resize', updateCarousel);
  }
});
</script>


