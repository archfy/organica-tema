{%- liquid
  if use_variant
    assign target = product.selected_or_first_available_variant
  else
    assign target = product
  endif
  assign compare_at_price = target.compare_at_price
  assign price = target.price | default: 1999
  assign available = target.available | default: false
  assign money_price = price | money
  if settings.currency_code_enabled
    assign money_price = price | money_with_currency
  endif
  if target == product and product.price_varies
    assign money_price = 'products.product.price.from_price_html' | t: price: money_price
  endif
  
  if compare_at_price > price
    assign discount_percentage = compare_at_price | minus: price | times: 100 | divided_by: compare_at_price
    assign installment_price = price | divided_by: 3
    assign installment_price_money = installment_price | money
  endif
-%}
<style>
  .item-center .bls__grid:not(.list) .bls__product-option, .item-center .bls__grid:not(.list) .bls__product-price{
  justify-content: center;
  display: grid;
  }
  .bls__price {
    display: flex;
    flex-direction: column;
  }
  .price-line-1 {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 3px;
    margin-left: auto;
  margin-right: auto;
  }
  .price-line-2-sticky {
    display: flex;
    align-items: center;
    gap: 5px;
    margin-top: -6px;
  }
  .compare-at-price {
    text-decoration: line-through;
    color: #888;
    font-size: 0.9em;
  }
  .discount-label-sticky {
    background-color:red;
    color: white;
    border-radius: 20px;
    padding: 2px 5px;
  height: auto;
  font-size: 11px;
  font-weight: 400;
  }
  .sale-price {
    color: #000;
    font-weight: bold;
    font-size: 1.1em;
  }
  .installment-price {
    color: #757575;
    font-size: 14px;
  }
</style>
<div
  class="
    bls__price
    {%- if available == false %} price--sold-out {% endif -%}
    {%- if compare_at_price > price %} price--on-sale {% endif -%}
    {%- if product.price_varies == false and product.compare_at_price_varies %} price--no-compare{% endif -%}
  "
>
  <div class="bls__product-price">
    {%- if compare_at_price > price %}
      <div class="price-line-1">
        <span class="sale-price">Por {{ money_price }}</span>
        <s class="compare-at-price">{{ compare_at_price | money }}</s>
        <span class="discount-label-sticky">-{{ discount_percentage | round }}% OFF</span>
      </div>
      <div class="price-line-2-sticky">
        <span class="installment-price">ou 3x de {{ installment_price_money }}</span>
        {% comment %}<s class="compare-at-price">{{ compare_at_price | money }}</s>
        <span class="discount-label-sticky">-{{ discount_percentage | round }}% OFF</span>
        {%  endcomment %}
      </div>
    {%- else -%}
      <div class="price-line-1">
        <span class="sale-price">{{ money_price }}</span>
        <s class="compare-at-price">{{ compare_at_price | money }}</s>
        <span class="discount-label-sticky">-{{ discount_percentage | round }}% OFF</span>
      </div>
      <div class="price-line-2-sticky">
        {%- if price > 0 -%}
          {%- assign installment_price = price | divided_by: 3 | money -%}
          <span class="installment-price">ou 3x de {{ installment_price }}</span>
        {%- endif -%}
        {% comment %}<s class="compare-at-price">{{ compare_at_price | money }}</s>
        <span class="discount-label-sticky">-{{ discount_percentage | round }}% OFF</span>
        {%  endcomment %}
      </div>
    {% endif -%}
    {% if product.selected_or_first_available_variant.unit_price_measurement != null %}
      <small class="unit-price caption mt-2">
        <span class="visually-hidden">{{ 'products.product.price.unit_price' | t }}</span>
        <span class="price-item price-item--last">
          <span class="number">{{- product.selected_or_first_available_variant.unit_price | money -}}</span>
          <span aria-hidden="true">/</span>
          <span class="visually-hidden">&nbsp;{{ 'accessibility.unit_price_separator' | t }}&nbsp;</span>
          <span class="unit">
            {%- if product.selected_or_first_available_variant.unit_price_measurement.reference_value != 1 -%}
              {{- product.selected_or_first_available_variant.unit_price_measurement.reference_value -}}
            {%- endif -%}
            {{ product.selected_or_first_available_variant.unit_price_measurement.reference_unit }}
          </span>
        </span>
      </small>
    {% endif %}
  </div>
</div>