<style>
  /* Parcelamento sempre em linha própria, abaixo do preço */
  .price__installments,
  [data-installments-wrapper] {
    display: block !important;
    flex-basis: 100% !important;
    width: 100% !important;
    margin-top: 4px;
  }

  .price__discount-badge {
    background-color: #ff0000;
    color: #FFFFFF;
    padding: 5px 10px;
    border-radius: 13px;
    font-size: 1rem;
    font-weight: bold;
    line-height: 1;
    position: relative;
    margin-left: 5px;
    bottom: 5px;
  }
  value-parcela-pdp-default{
  display:inline-block!important;
}
   @media (min-width: 767px) {
    .break-mobile {
      display: block;
    }
  }
  /* No desktop, ele volta ao normal (um ao lado do outro) */
  @media (min-width: 768px) {
    .break-mobile {
      display: inline;
    }
  }
</style>



{%- liquid
  if use_variant
    assign target = product.selected_or_first_available_variant
  else
    assign target = product
  endif
  assign compare_at_price = target.compare_at_price
  assign price = target.price | default: 1999
  assign available = target.available | default: false
  assign money_price = price | money
  if settings.currency_code_enabled
    assign money_price = price | money_with_currency
  endif
  if target == product and product.price_varies
    assign money_price = 'products.product.price.from_price_html' | t: price: money_price
  endif
  assign discount_percentage = compare_at_price | minus: price | times: 100.0 | divided_by: compare_at_price | round

  comment
    ============================================
    PARCELAMENTO PDP - parcela mínima R$50 (5000 centavos)
    ============================================
  endcomment
  assign min_installment_cents = 4999
  assign max_installments = 10
  assign installment_count = 0
  assign possible_installments = price | divided_by: min_installment_cents
  if possible_installments >= 2
    assign installment_count = possible_installments
    if installment_count > max_installments
      assign installment_count = max_installments
    endif
  endif
  if installment_count > 0
    assign installment_value = price | divided_by: installment_count
  endif
-%}

{%- comment -%} 
  ========================================
  WRAPPER PRINCIPAL - Este div será atualizado via innerHTML
  ========================================
{%- endcomment -%}
<div id="price-pdp-wrapper" data-price-wrapper>
  <div
    class="
      bls__price
      {%- if available == false %} price--sold-out {% endif -%}
      {%- if compare_at_price > price %} price--on-sale {% endif -%}
      {%- if product.price_varies == false and product.compare_at_price_varies %} price--no-compare{% endif -%}
    "
  >
    <div class="bls__product-price flex flex-wrap align-items-center mt-3">
      <div class="price__regular">
        <span class="visually-hidden visually-hidden--inline">{{ 'products.product.price.regular_price' | t }}</span>
        <span class="price{%- if compare_at_price > price %} special-price {% endif -%}" data-product-price>
     {{ money_price }}
        </span>
      </div>
      {%- if compare_at_price > price %}
        {%- unless product.price_varies == false and product.compare_at_price_varies %}
          <div class="price__sale grey-color" data-sale-price-wrapper>
              <span class="visually-hidden visually-hidden--inline">{{ 'products.product.price.sale_price' | t }}</span>
              <span>
                <s class="price-item compare-price" data-compare-price>
                  {% if settings.currency_code_enabled %}
                    {{ compare_at_price | money_with_currency }}
                  {% else %}
                    {{ compare_at_price | money }}
                  {% endif %}
                </s>
              </span>
              <span class="price__discount-badge" data-discount-badge>
                {{ discount_percentage }}% OFF
              </span>
          </div>
        {%- endunless -%}
      {%- endif -%}

      

      {% if product.selected_or_first_available_variant.unit_price_measurement != null %}
        <small class="unit-price caption">
          <span class="visually-hidden">{{ 'products.product.price.unit_price' | t }}</span>
          <span class="price-item price-item--last">
            <span class="number">{{- product.selected_or_first_available_variant.unit_price | money -}}</span>
            <span aria-hidden="true">/</span>
            <span class="visually-hidden">&nbsp;{{ 'accessibility.unit_price_separator' | t }}&nbsp;</span>
            <span class="unit">
              {%- if product.selected_or_first_available_variant.unit_price_measurement.reference_value != 1 -%}
                {{- product.selected_or_first_available_variant.unit_price_measurement.reference_value -}}
              {%- endif -%}
              {{ product.selected_or_first_available_variant.unit_price_measurement.reference_unit }}
            </span>
          </span>
        </small>
      {% endif %}
    </div>
    {%- comment -%} PARCELAMENTO DINÂMICO {%- endcomment -%}
      {%- if installment_count > 0 -%}
        <div class="price__installments" data-installments-wrapper>
          <span class="text-gray-600 text-[12px] text-juros-grid">
            ou {{ installment_count }}x de
            <span class="value-parcela-pdp" style="display:inline-block">{{ installment_value | money }}</span>
          </span>
        </div>
      {%- endif -%}
  </div>
</div>

<script>
(function() {
  console.log('🔥 PRICE-PDP v5.0 CARREGADO (parcelamento via patch)');

  function formatMoney(cents) {
    return 'R$ ' + (cents / 100).toFixed(2).replace('.', ',');
  }

  function calcInstallments(priceCents) {
    var MIN = 5000; // R$50 em centavos
    var MAX = 12;
    var count = Math.floor(priceCents / MIN);
    if (count < 2) return null;
    if (count > MAX) count = MAX;
    return { count: count, value: Math.floor(priceCents / count) };
  }

  // Atualiza ou cria o bloco de parcelamento em #price-pdp-wrapper
  // Usa insertAdjacentElement('afterend') para garantir posição DEPOIS do flex container
  function updateInstallments(priceCents) {
    var wrapper = document.getElementById('price-pdp-wrapper');
    if (!wrapper) return;

    var inst = calcInstallments(priceCents);
    var installDiv = wrapper.querySelector('[data-installments-wrapper]');

    if (!inst) {
      if (installDiv) installDiv.style.display = 'none';
      return;
    }

    var instStr = formatMoney(inst.value);

    if (installDiv) {
      installDiv.style.display = '';
      var jurosSpan = installDiv.querySelector('.text-juros-grid');
      if (jurosSpan) {
        jurosSpan.innerHTML = 'ou ' + inst.count + 'x de <span class="value-parcela-pdp" style="display:inline-block">' + instStr + '</span>';
      }
    } else {
      // Insere APÓS .bls__product-price (fora do flex container)
      var flexContainer = wrapper.querySelector('.bls__product-price');
      if (flexContainer) {
        installDiv = document.createElement('div');
        installDiv.className = 'price__installments';
        installDiv.setAttribute('data-installments-wrapper', '');
        installDiv.innerHTML = '<span class="text-gray-600 text-[12px] text-juros-grid">ou ' + inst.count + 'x de <span class="value-parcela-pdp" style="display:inline-block">' + instStr + '</span></span>';
        flexContainer.insertAdjacentElement('afterend', installDiv);
      }
    }

    // Atualiza elementos externos .value-parcela-pdp e .value-vista-pdp
    document.querySelectorAll('.value-parcela-pdp').forEach(function(el) {
      el.textContent = instStr;
    });
    document.querySelectorAll('.value-vista-pdp').forEach(function(el) {
      el.textContent = formatMoney(priceCents);
    });
  }

  function patchVariantSelects() {
    var VariantSelectsClass = customElements.get('variant-selects');
    if (!VariantSelectsClass || VariantSelectsClass.prototype.__pdpInstPatch) return;
    VariantSelectsClass.prototype.__pdpInstPatch = true;

    var _orig = VariantSelectsClass.prototype.renderProductInfo;
    VariantSelectsClass.prototype.renderProductInfo = function() {
      _orig.call(this);
      var price = this.currentVariant && this.currentVariant.price;
      if (price) updateInstallments(price);
    };
    console.log('✅ [PRICE-PDP v5.0] VariantSelects patchado!');
  }

  if (customElements.get('variant-selects')) {
    patchVariantSelects();
  } else {
    customElements.whenDefined('variant-selects').then(patchVariantSelects);
  }

})();
</script>
